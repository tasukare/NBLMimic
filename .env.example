# ============================================================
# NBLMimic — Environment Configuration Template
# ============================================================
#
# HOW TO USE:
# 1. Duplicate this file and rename it to: .env
# 2. Add your Google Gemini API key below:
#    Get a free key from Google AI Studio: https://aistudio.google.com/
# 3. Start the secure server:
#    node server.js
#
# NOTE: .env is automatically protected by .gitignore and will NEVER be uploaded to GitHub.

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Google OAuth 2.0 Web Client Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Firebase Web App & Authentication Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=static-webbing-512407-b3.firebaseapp.com
FIREBASE_PROJECT_ID=static-webbing-512407-b3
FIREBASE_STORAGE_BUCKET=static-webbing-512407-b3.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=809750403592
FIREBASE_APP_ID=your_firebase_app_id_here
