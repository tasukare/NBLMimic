      <button class="live-mic-btn" id="btn-live-mic-toggle" onclick="toggleLiveAudioSession()">
        <svg id="live-mic-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="23"></line>
          <line x1="8" y1="23" x2="16" y2="23"></line>
        </svg>
      </button>
      <span style="font-size:12px; color:#9ca3af;" id="live-status-text">Click microphone to speak</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     SETTINGS MODAL
     ══════════════════════════════════════════════════════════════ -->
<div class="g-modal-overlay" id="settings-modal" role="dialog" aria-modal="true" aria-labelledby="settings-modal-title">
  <div class="generic-modal">
    <div class="generic-modal-header">
      <h3 class="generic-modal-title" id="settings-modal-title">Settings & Configuration</h3>
      <button class="btn-icon" onclick="closeSettingsModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div style="display:flex; flex-direction:column; gap:14px;">
      <div>
        <label style="font-size:12px; font-weight:600; color:var(--text-secondary); display:block; margin-bottom:6px;">Gemini API Key (.env or browser)</label>
        <input type="password" id="settings-api-key" placeholder="AIzaSy..." style="width:100%; height:36px; padding:0 10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--bg-secondary); outline:none; font-size:13px; color:var(--text-primary);">
        <span style="font-size:11px; color:var(--text-tertiary); display:block; margin-top:4px;" id="settings-key-sync-label">Checking server .env sync...</span>
      </div>

      <div>
        <label style="font-size:12px; font-weight:600; color:var(--text-secondary); display:block; margin-bottom:6px;">Default Gemini Model</label>
        <select id="settings-model-default" style="width:100%; height:36px; padding:0 10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--bg-secondary); outline:none; font-size:13px; color:var(--text-primary);">
          <option value="gemini-3.5-flash-lite">gemini-3.5-flash-lite (Recommended: &lt;1s response & free tier)</option>
          <option value="gemini-3.5-flash">gemini-3.5-flash (Standard 1M context)</option>
          <option value="gemini-3.8-flash">gemini-3.8-flash (Preview Multimodal Reasoning)</option>
        </select>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; padding:12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-secondary);">
        <div>
          <div style="font-size:13px; font-weight:600; color:var(--text-primary);">Clear Local Cache</div>
          <div style="font-size:11.5px; color:var(--text-tertiary);">Reset notes and reload fresh news feeds</div>
        </div>
        <button class="btn-note-action" style="flex:none; padding:0 12px;" onclick="resetLocalStorage()">Reset Data</button>
      </div>

      <div style="display:flex; justify-content:flex-end; margin-top:8px;">
        <button class="btn-add-source" style="flex:none; padding:0 20px;" onclick="saveSettings()">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Toast Container -->
<div class="toast-stack" id="toast-container"></div>

<!-- ══════════════════════════════════════════════════════════════
     VANILLA JAVASCRIPT APPLICATION CORE
     ══════════════════════════════════════════════════════════════ -->
<script>
/**
 * NBLMimic — Research Lab Core Application
 * Zero-dependency, lightweight, privacy-first research notebook.
 */

// 1. Application State
const state = {
  user: null,               // Google profile: { name, email, picture, sub }
  sources: [],              // Loaded sources & live news
  activeSourceIds: new Set(), // IDs of sources grounded in AI chat
  selectedDocId: null,      // Document currently open in reader
  filterCategory: 'all',    // Current category pill
  searchQuery: '',          // Current search filter
  currentTab: 'chat',       // 'chat' or 'notes'
  activeModel: 'gemini-3.5-flash-lite',
  chatMessages: [],         // Chat history
  notesContent: '',         // Scratchpad notes
  googleClientId: '809750403592-tven0oabpuiq37oi8um5f102ck3lclkg.apps.googleusercontent.com',
  isRegisterMode: false
};

// 2. Sample Baseline Sources (used if offline / before news sync)
const SAMPLE_SOURCES = [
  {
    id: 1,
    title: 'Gemini 3.8 Multimodal Reasoning & Live Bidirectional Audio',
    category: 'AI & ML',
    source: 'Google DeepMind',
    excerpt: 'An architectural breakdown of low-latency bidirectional WebSockets and grounded citation graphs.',
    content: 'Gemini 3.8 introduces sub-second multimodal reasoning and real-time audio interaction over WebSockets.\n\nKey Innovations:\n- Asynchronous function calling without interrupting conversation flow.\n- Grounded citation graphs linking every generative claim directly to user uploaded documents.\n- Low-overhead token efficiency optimized for research synthesis.',
    date: 'Today',
    timestamp: Date.now()
  },
  {
    id: 2,
    title: 'Private Knowledge Bases and Local-First Architecture',
    category: 'Tech & Dev',
    source: 'Research Lab',
    excerpt: 'Why research notebooks must prioritize local-first storage and transparent zero-dependency servers.',
    content: 'Storing knowledge graphs and confidential research papers locally guarantees zero data leakage.\n\nBy leveraging standard Web APIs and client-side encryption, researchers maintain full control over intellectual property without trusting multi-tenant cloud databases.',
    date: 'Yesterday',
    timestamp: Date.now() - 86400000
  }
];

// ══════════════════════════════════════════════════════════════
// INITIALIZATION
// ══════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  loadSavedTheme();
  loadSavedUser();
  loadSavedNotes();
  setupUIEventListeners();
  fetchServerAuthConfig();
  fetchLiveNewsStream();
  checkServerHealth();
});

// ══════════════════════════════════════════════════════════════
// GOOGLE IDENTITY SERVICES (GSI) AUTHENTICATION
// ══════════════════════════════════════════════════════════════

async function fetchServerAuthConfig() {
  try {
    const res = await fetch('/api/auth/config');
    if (res.ok) {
      const data = await res.json();
      if (data.clientId) {
        state.googleClientId = data.clientId;
        initGoogleGSI();
      }
    }
  } catch (e) {
    console.log('[Auth] Using default Google client ID');
  }
}

function initGoogleGSI() {
  if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) {
    return;
  }

  try {
    google.accounts.id.initialize({
      client_id: state.googleClientId,
      callback: handleGoogleCredentialResponse,
      auto_select: false,
      cancel_on_tap_outside: true
    });

    renderOfficialGoogleButton();
  } catch (err) {
    console.warn('[GSI] Init error:', err);
  }
}

function renderOfficialGoogleButton() {
  const mountEl = document.getElementById('gsi-button-mount');
  if (mountEl && typeof google !== 'undefined' && google.accounts?.id) {
    mountEl.innerHTML = '';
    google.accounts.id.renderButton(mountEl, {
      type: 'standard',
      shape: 'pill',
      theme: document.documentElement.getAttribute('data-theme') === 'dark' ? 'filled_black' : 'outline',
      size: 'large',
      text: 'signin_with',
      width: 320,
      logo_alignment: 'left'
    });
  }
}

function handleGoogleCredentialResponse(response) {
  if (!response || !response.credential) return;

  try {
    // Safely decode JWT token payload without external libraries
    const base64Url = response.credential.split('.')[1];
    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
    const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => {
      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
    }).join(''));

    const profile = JSON.parse(jsonPayload);

    state.user = {
      name: profile.name || 'Google User',
      email: profile.email || '',
      picture: profile.picture || '',
      sub: profile.sub
    };

    localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
    updateAuthUI();
    closeSignInModal();
    showToast(`Signed in as ${state.user.name}`);
  } catch (err) {
    console.error('[Auth] Failed to parse Google JWT:', err);
    showToast('Failed to parse Google sign-in response');
  }
}

function loadSavedUser() {
  try {
    const raw = localStorage.getItem('nbl_user_session');
    if (raw) {
      state.user = JSON.parse(raw);
    }
  } catch (e) {}
  updateAuthUI();
}

function updateAuthUI() {
  const btnOpenSignin = document.getElementById('btn-open-signin');
  const userHeaderWrap = document.getElementById('user-header-wrap');
  const activeUserView = document.getElementById('g-active-user-view');
  const unauthView = document.getElementById('g-unauth-view');

  if (state.user) {
    // User is logged in
    btnOpenSignin.style.display = 'none';
    userHeaderWrap.style.display = 'flex';

    // Header avatar
    const initial = (state.user.name || state.user.email || 'U')[0].toUpperCase();
    document.getElementById('header-avatar-initials').textContent = initial;
    const headerImg = document.getElementById('header-avatar-img');
    if (state.user.picture) {
      headerImg.src = state.user.picture;
      headerImg.style.display = 'block';
      document.getElementById('header-avatar-initials').style.display = 'none';
    } else {
      headerImg.style.display = 'none';
      document.getElementById('header-avatar-initials').style.display = 'block';
    }

    // Google Account Flyout details
    document.getElementById('gaf-name').textContent = state.user.name;
    document.getElementById('gaf-email').textContent = state.user.email;
    document.getElementById('gaf-initials').textContent = initial;
    const gafImg = document.getElementById('gaf-img');
    if (state.user.picture) {
      gafImg.src = state.user.picture;
      gafImg.style.display = 'block';
      document.getElementById('gaf-initials').style.display = 'none';
    } else {
      gafImg.style.display = 'none';
      document.getElementById('gaf-initials').style.display = 'block';
    }

    // Sign-in modal card details
    document.getElementById('g-card-name').textContent = state.user.name;
    document.getElementById('g-card-email').textContent = state.user.email;
    document.getElementById('g-card-initials').textContent = initial;
    const cardImg = document.getElementById('g-card-img');
    if (state.user.picture) {
      cardImg.src = state.user.picture;
      cardImg.style.display = 'block';
      document.getElementById('g-card-initials').style.display = 'none';
    } else {
      cardImg.style.display = 'none';
      document.getElementById('g-card-initials').style.display = 'block';
    }

    activeUserView.style.display = 'block';
    unauthView.style.display = 'none';
    document.getElementById('g-signin-title').textContent = 'Google Account';
  } else {
    // User is signed out
    btnOpenSignin.style.display = 'inline-flex';
    userHeaderWrap.style.display = 'none';
    document.getElementById('google-account-flyout').classList.remove('active');

    activeUserView.style.display = 'none';
    unauthView.style.display = 'block';
    document.getElementById('g-signin-title').textContent = state.isRegisterMode ? 'Create Account' : 'Sign in';
  }
}

function signOutGoogleUser() {
  state.user = null;
  localStorage.removeItem('nbl_user_session');
  updateAuthUI();
  closeSignInModal();
  showToast('Signed out of Google Account');
}

function handleDirectAuthSubmit(e) {
  e.preventDefault();
  const emailInput = document.getElementById('g-input-email');
  const val = emailInput.value.trim();
  if (!val) return;

  const displayName = val.includes('@') ? val.split('@')[0] : val;
  state.user = {
    name: displayName,
    email: val.includes('@') ? val : `${val}@gmail.com`,
    picture: ''
  };

  localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
  updateAuthUI();
  closeSignInModal();
  showToast(`Welcome, ${displayName}!`);
}

function loginDemoAccount() {
  state.user = {
    name: 'Dr. Jane Vance',
    email: 'jane.vance.research@gmail.com',
    picture: ''
  };
  localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
  updateAuthUI();
  closeSignInModal();
  showToast('Logged in as Demo Researcher');
}

function toggleRegisterMode() {
  state.isRegisterMode = !state.isRegisterMode;
  const btnToggle = document.getElementById('btn-toggle-create-account');
  const btnSubmit = document.getElementById('btn-g-submit');
  const title = document.getElementById('g-signin-title');

  if (state.isRegisterMode) {
    title.textContent = 'Create Account';
    btnToggle.textContent = 'Sign in instead';
    btnSubmit.textContent = 'Create';
  } else {
    title.textContent = 'Sign in';
    btnToggle.textContent = 'Create account';
    btnSubmit.textContent = 'Next';
  }
}

// ══════════════════════════════════════════════════════════════
// MODAL CONTROLS
// ══════════════════════════════════════════════════════════════

function openSignInModal() {
  document.getElementById('google-account-flyout').classList.remove('active');
  const modal = document.getElementById('google-signin-modal');
  modal.classList.add('active');
  renderOfficialGoogleButton();
}

function closeSignInModal() {
  document.getElementById('google-signin-modal').classList.remove('active');
}

function toggleGoogleAccountFlyout() {
  const flyout = document.getElementById('google-account-flyout');
  flyout.classList.toggle('active');
}

function openUploadModal() {
  document.getElementById('upload-modal').classList.add('active');
}

function closeUploadModal() {
  document.getElementById('upload-modal').classList.remove('active');
}

function openLiveModal() {
  document.getElementById('live-voice-modal').classList.add('active');
  startVisualizerAnimation();
}

function closeLiveModal() {
  document.getElementById('live-voice-modal').classList.remove('active');
  stopVisualizerAnimation();
}

function openSettingsModal() {
  document.getElementById('settings-modal').classList.add('active');
}

function closeSettingsModal() {
  document.getElementById('settings-modal').classList.remove('active');
}

// Close modals on Esc or backdrop click
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeSignInModal();
    closeUploadModal();
    closeLiveModal();
    closeSettingsModal();
    document.getElementById('google-account-flyout').classList.remove('active');
  }
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault();
    document.getElementById('search-input').focus();
  }
});

// Click outside flyout to close
document.addEventListener('click', (e) => {
  const flyout = document.getElementById('google-account-flyout');
  const avatarBtn = document.getElementById('btn-toggle-account-flyout');
  if (flyout && flyout.classList.contains('active')) {
    if (!flyout.contains(e.target) && !avatarBtn.contains(e.target)) {
      flyout.classList.remove('active');
    }
  }
});

// ══════════════════════════════════════════════════════════════
// SOURCES & LIVE NEWS
// ══════════════════════════════════════════════════════════════

async function fetchLiveNewsStream(force = false) {
  const syncIcon = document.getElementById('sync-news-icon');
  if (syncIcon) syncIcon.classList.add('spin');

  try {
    const res = await fetch(`/api/news${force ? '?refresh=1' : ''}`);
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data.articles) && data.articles.length > 0) {
        state.sources = data.articles;
        // Default first 3 sources as active for research grounding
        if (state.activeSourceIds.size === 0) {
          state.sources.slice(0, 3).forEach(s => state.activeSourceIds.add(s.id));
        }
        renderSources();
        if (!state.selectedDocId && state.sources.length > 0) {
          selectDocument(state.sources[0].id);
        }
        showToast(`Loaded ${data.articles.length} research stories`);
      }
    } else {
      fallbackSampleSources();
    }
  } catch (err) {
    fallbackSampleSources();
  } finally {
    if (syncIcon) syncIcon.classList.remove('spin');
  }
}

function fallbackSampleSources() {
  if (state.sources.length === 0) {
    state.sources = [...SAMPLE_SOURCES];
    state.sources.forEach(s => state.activeSourceIds.add(s.id));
    renderSources();
    selectDocument(state.sources[0].id);
  }
}

function renderSources() {
  const container = document.getElementById('sources-container');
  container.innerHTML = '';

  const filtered = state.sources.filter(source => {
    // Category filter
    if (state.filterCategory !== 'all') {
      if (state.filterCategory === 'Notes & Uploads') {
        if (source.type !== 'note' && source.type !== 'upload') return false;
      } else if (source.category !== state.filterCategory) {
        return false;
      }
    }
    // Search query filter
    if (state.searchQuery) {
      const q = state.searchQuery.toLowerCase();
      const matchTitle = (source.title || '').toLowerCase().includes(q);
      const matchContent = (source.content || '').toLowerCase().includes(q);
      const matchExcerpt = (source.excerpt || '').toLowerCase().includes(q);
      return matchTitle || matchContent || matchExcerpt;
    }
    return true;
  });

  document.getElementById('sources-count-badge').textContent = state.sources.length;
  document.getElementById('grounded-count-label').textContent = `${state.activeSourceIds.size} active for AI`;
  document.getElementById('chat-grounding-text').textContent = `${state.activeSourceIds.size} sources`;

  if (filtered.length === 0) {
    container.innerHTML = `
      <div style="text-align:center; padding:32px 16px; color:var(--text-tertiary); font-size:12.5px;">
        No sources matching filter.
      </div>
    `;
    return;
  }

  filtered.forEach(source => {
    const isChecked = state.activeSourceIds.has(source.id);
    const isSelected = state.selectedDocId === source.id;

    const card = document.createElement('div');
    card.className = `source-card ${isSelected ? 'active-reading' : ''}`;
    card.onclick = (e) => {
      if (e.target.type !== 'checkbox') {
        selectDocument(source.id);
      }
    };

    card.innerHTML = `
      <div class="source-card-top">
        <span class="source-badge-tag">${source.icon || '📄'} ${source.category || 'Research'}</span>
        <label class="source-checkbox-wrap" title="Include in Grounded AI Context">
          <input type="checkbox" class="source-checkbox" ${isChecked ? 'checked' : ''} onchange="toggleSourceGrounding(${source.id}, this.checked)">
        </label>
      </div>
      <div class="source-card-title">${escapeHTML(source.title)}</div>
      <div class="source-card-excerpt">${escapeHTML(source.excerpt || '')}</div>
      <div class="source-card-meta">
        <span class="source-author-domain">${escapeHTML(source.source || 'Local')}</span>
        <span>${escapeHTML(source.date || 'Today')}</span>
      </div>
    `;

    container.appendChild(card);
  });
}

function toggleSourceGrounding(id, isChecked) {
  if (isChecked) {
    state.activeSourceIds.add(id);
  } else {
    state.activeSourceIds.delete(id);
  }
  document.getElementById('grounded-count-label').textContent = `${state.activeSourceIds.size} active for AI`;
  document.getElementById('chat-grounding-text').textContent = `${state.activeSourceIds.size} sources`;
  updateReaderToolbar();
}

function selectDocument(id) {
  state.selectedDocId = id;
  const doc = state.sources.find(s => s.id === id);
  if (!doc) return;

  renderSources();
  renderReaderDocument(doc);
}

function renderReaderDocument(doc) {
  const container = document.getElementById('reader-view');
  const isGrounded = state.activeSourceIds.has(doc.id);

  // Update external link button
  const extBtn = document.getElementById('btn-open-external-source');
  if (doc.url) {
    extBtn.style.display = 'inline-flex';
    extBtn.onclick = () => window.open(doc.url, '_blank');
  } else {
    extBtn.style.display = 'none';
  }

  // Word count & reading time calculation
  const words = (doc.content || '').split(/\s+/).filter(Boolean).length;
  const readTimeMin = Math.ceil(words / 200) || 1;

  container.innerHTML = `
    <article>
      <div class="reader-header-area">
        <span class="reader-category-pill">${doc.icon || '📄'} ${escapeHTML(doc.category || 'General')}</span>
        <h1 class="reader-title">${escapeHTML(doc.title)}</h1>
        <div class="reader-meta-row">
          <span class="reader-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            ${readTimeMin} min read
          </span>
          <span>&bull;</span>
          <span class="reader-meta-item">${words} words</span>
          <span>&bull;</span>
          <span class="reader-meta-item">Published by ${escapeHTML(doc.source || 'Notebook')}</span>
        </div>
      </div>
      <div class="reader-body">
        ${formatReaderProse(doc.content || '')}
      </div>
    </article>
  `;

  updateReaderToolbar();
}

function updateReaderToolbar() {
  const groundedBadge = document.getElementById('reader-grounded-status');
  if (!state.selectedDocId) {
    groundedBadge.style.display = 'none';
    return;
  }
  const isGrounded = state.activeSourceIds.has(state.selectedDocId);
  if (isGrounded) {
    groundedBadge.style.display = 'inline-flex';
    groundedBadge.innerHTML = `
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span>Grounded in AI Chat</span>
    `;
    groundedBadge.style.color = 'var(--success)';
  } else {
    groundedBadge.style.display = 'inline-flex';
    groundedBadge.innerHTML = `<span>Not included in chat context</span>`;
    groundedBadge.style.color = 'var(--text-tertiary)';
  }
}

function formatReaderProse(text) {
  if (!text) return '';
  return text.split(/\n\n+/).map(para => {
    const trimmed = para.trim();
    if (trimmed.startsWith('# ')) {
      return `<h2>${escapeHTML(trimmed.slice(2))}</h2>`;
    }
    if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
      const items = trimmed.split('\n').map(li => `<li>${escapeHTML(li.replace(/^[-*]\s+/, ''))}</li>`).join('');
      return `<ul>${items}</ul>`;
    }
    return `<p>${escapeHTML(trimmed)}</p>`;
  }).join('');
}

// ══════════════════════════════════════════════════════════════
// GROUNDED AI RESEARCH CHAT
// ══════════════════════════════════════════════════════════════

document.getElementById('chat-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;

  // Add User Message
  appendChatMessage('user', text);
  input.value = '';
  input.style.height = 'auto';

  // Grounding context from active sources
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  let contextBlock = '';
  activeSources.forEach((src, idx) => {
    contextBlock += `[Source ${idx + 1}: "${src.title}"]\n${src.content}\n\n`;
  });

  const systemInstruction = `You are a high-level research assistant inside Research Lab (NBLMimic).
Answer the user's research queries grounded strictly in the provided research sources.
Whenever citing information from a source, append a strict citation bracket like [1], [2], corresponding to the source number.
If information is not contained in the sources, clearly state so.
Keep answers concise, insightful, and formatted with markdown.`;

  // Append Thinking Indicator
  const thinkingId = appendChatThinking();

  try {
    const model = document.getElementById('chat-model-select').value;
    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: model,
        system_instruction: { parts: [{ text: systemInstruction }] },
        contents: [
          {
            role: 'user',
            parts: [{ text: `SOURCES:\n${contextBlock}\n\nUSER QUESTION:\n${text}` }]
          }
        ]
      })
    });

    removeChatThinking(thinkingId);

    if (res.ok) {
      const data = await res.json();
      const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'No response generated.';
      appendChatMessage('ai', reply);
    } else {
      const err = await res.json().catch(() => ({}));
      appendChatMessage('ai', `⚠️ Error: ${err.error?.message || 'Server request failed'}`);
    }
  } catch (err) {
    removeChatThinking(thinkingId);
    appendChatMessage('ai', `⚠️ Network error: ${err.message}. Check that the local server is running.`);
  }
});

function appendChatMessage(role, text) {
  const stream = document.getElementById('chat-stream');
  const bubble = document.createElement('div');
  bubble.className = `chat-bubble ${role}`;

  const content = document.createElement('div');
  content.className = 'bubble-content';

  if (role === 'ai') {
    // Parse citation tags [1], [2] to interactive clickable pills
    let html = escapeHTML(text);
    html = html.replace(/\[(\d+)\]/g, (match, p1) => {
      return `<button class="citation-tag" onclick="jumpToCitationSource(${p1})">[${p1}]</button>`;
    });
    // Parse markdown headers and bold
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
    html = html.replace(/\n/g, '<br>');
    content.innerHTML = html;
  } else {
    content.textContent = text;
  }

  bubble.appendChild(content);
  stream.appendChild(bubble);
  stream.scrollTop = stream.scrollHeight;
}

function appendChatThinking() {
  const stream = document.getElementById('chat-stream');
  const id = 'thinking-' + Date.now();
  const bubble = document.createElement('div');
  bubble.className = 'chat-bubble ai';
  bubble.id = id;
  bubble.innerHTML = `
    <div class="bubble-content" style="color:var(--text-tertiary); font-style:italic;">
      Synthesizing across active sources...
    </div>
  `;
  stream.appendChild(bubble);
  stream.scrollTop = stream.scrollHeight;
  return id;
}

function removeChatThinking(id) {
  const el = document.getElementById(id);
  if (el) el.remove();
}

function jumpToCitationSource(index) {
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  const target = activeSources[index - 1];
  if (target) {
    selectDocument(target.id);
    showToast(`Navigated to Citation [${index}]: ${target.title}`);
  }
}

function clearChatHistory() {
  const stream = document.getElementById('chat-stream');
  stream.innerHTML = `
    <div class="chat-bubble ai">
      <div class="bubble-content">
        Chat cleared. Ready for your next research question!
      </div>
    </div>
  `;
}

// ══════════════════════════════════════════════════════════════
// LAB NOTES SYNTHESIS
// ══════════════════════════════════════════════════════════════

const notesEditor = document.getElementById('notes-editor');

notesEditor.addEventListener('input', () => {
  state.notesContent = notesEditor.value;
  localStorage.setItem('nbl_lab_notes', state.notesContent);
  updateNotesStats();
});

function loadSavedNotes() {
  const saved = localStorage.getItem('nbl_lab_notes');
  if (saved) {
    state.notesContent = saved;
    notesEditor.value = saved;
    updateNotesStats();
  }
}

function updateNotesStats() {
  const words = state.notesContent.trim().split(/\s+/).filter(Boolean).length;
  document.getElementById('notes-stat-words').textContent = `${words} words`;
  document.getElementById('notes-save-status').textContent = 'Saved to Drive (Local)';
}

function copyLabNotes() {
  navigator.clipboard.writeText(notesEditor.value);
  showToast('Lab notes copied to clipboard');
}

function downloadLabNotes() {
  const blob = new Blob([notesEditor.value], { type: 'text/markdown;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `Research_Notes_${new Date().toISOString().slice(0, 10)}.md`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('Saved notes to .md file');
}

function switchPanelTab(tab) {
  state.currentTab = tab;
  document.getElementById('tab-btn-chat').classList.toggle('active', tab === 'chat');
  document.getElementById('tab-btn-notes').classList.toggle('active', tab === 'notes');
  document.getElementById('tab-content-chat').classList.toggle('active', tab === 'chat');
  document.getElementById('tab-content-notes').classList.toggle('active', tab === 'notes');
}

// ══════════════════════════════════════════════════════════════
// MANUAL SOURCE / FILE UPLOAD
// ══════════════════════════════════════════════════════════════

function addManualSource() {
  const title = document.getElementById('manual-source-title').value.trim();
  const content = document.getElementById('manual-source-content').value.trim();
  if (!title || !content) {
    showToast('Please provide both title and content');
    return;
  }

  const newSource = {
    id: Date.now(),
    type: 'note',
    icon: '📝',
    title: title,
    source: 'My Research Note',
    category: 'Notes & Uploads',
    excerpt: content.slice(0, 160) + (content.length > 160 ? '…' : ''),
    content: content,
    date: 'Just now',
    timestamp: Date.now()
  };

  state.sources.unshift(newSource);
  state.activeSourceIds.add(newSource.id);
  renderSources();
  selectDocument(newSource.id);
  closeUploadModal();
  document.getElementById('manual-source-title').value = '';
  document.getElementById('manual-source-content').value = '';
  showToast('Source added to research notebook');
}

// Drag & drop file uploads
const dropzone = document.getElementById('file-dropzone');
dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
dropzone.addEventListener('drop', (e) => {
  e.preventDefault();
  dropzone.classList.remove('dragover');
  if (e.dataTransfer.files?.length) {
    handleFileUpload(e.dataTransfer.files[0]);
  }
});

document.getElementById('file-input').addEventListener('change', (e) => {
  if (e.target.files?.length) {
    handleFileUpload(e.target.files[0]);
  }
});

function handleFileUpload(file) {
  const reader = new FileReader();
  reader.onload = (e) => {
    const text = e.target.result;
    const newSource = {
      id: Date.now(),
      type: 'upload',
      icon: '📄',
      title: file.name,
      source: 'Uploaded File',
      category: 'Notes & Uploads',
      excerpt: text.slice(0, 160) + (text.length > 160 ? '…' : ''),
      content: text,
      date: 'Just now',
      timestamp: Date.now()
    };
    state.sources.unshift(newSource);
    state.activeSourceIds.add(newSource.id);
    renderSources();
    selectDocument(newSource.id);
    closeUploadModal();
    showToast(`Uploaded ${file.name}`);
  };
  reader.readAsText(file);
}

// ══════════════════════════════════════════════════════════════
// GEMINI 3.8 LIVE AUDIO VISUALIZER
// ══════════════════════════════════════════════════════════════

let visualizerAnimationId = null;
let isLiveMicActive = false;

function startVisualizerAnimation() {
  const canvas = document.getElementById('live-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let phase = 0;

  function renderWave() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const midY = canvas.height / 2;

    for (let wave = 0; wave < 3; wave++) {
      ctx.beginPath();
      ctx.lineWidth = 2;
      ctx.strokeStyle = wave === 0 ? '#38bdf8' : (wave === 1 ? '#818cf8' : '#c084fc');

      for (let x = 0; x < canvas.width; x++) {
        const freq = 0.02 + wave * 0.01;
        const amp = isLiveMicActive ? 24 : 8;
        const y = midY + Math.sin(x * freq + phase + wave) * amp * Math.sin(x / canvas.width * Math.PI);
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    phase += isLiveMicActive ? 0.08 : 0.03;
    visualizerAnimationId = requestAnimationFrame(renderWave);
  }

  renderWave();
}

function stopVisualizerAnimation() {
  if (visualizerAnimationId) {
    cancelAnimationFrame(visualizerAnimationId);
    visualizerAnimationId = null;
  }
}

function toggleLiveAudioSession() {
  isLiveMicActive = !isLiveMicActive;
  const btn = document.getElementById('btn-live-mic-toggle');
  const status = document.getElementById('live-status-text');
  const transcript = document.getElementById('live-transcript');

  btn.classList.toggle('active', isLiveMicActive);
  if (isLiveMicActive) {
    status.textContent = 'Listening and streaming bidirectional audio...';
    transcript.innerHTML = `<strong>Live Session Active:</strong> Gemini 3.8 Live listening to conversation...`;
    showToast('Gemini 3.8 Live audio active');
  } else {
    status.textContent = 'Session paused. Click microphone to speak.';
  }
}

// ══════════════════════════════════════════════════════════════
// THEME & SETTINGS
// ══════════════════════════════════════════════════════════════

function loadSavedTheme() {
  const saved = localStorage.getItem('nbl_theme') || 'light';
  applyTheme(saved);
}

function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');
  if (theme === 'dark') {
    sunIcon.style.display = 'block';
    moonIcon.style.display = 'none';
  } else {
    sunIcon.style.display = 'none';
    moonIcon.style.display = 'block';
  }
  renderOfficialGoogleButton();
}

function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'dark' ? 'light' : 'dark';
  applyTheme(next);
  localStorage.setItem('nbl_theme', next);
}

async function checkServerHealth() {
  try {
    const res = await fetch('/api/health');
    if (res.ok) {
      const data = await res.json();
      const label = document.getElementById('settings-key-sync-label');
      if (data.hasServerKey) {
        label.textContent = '✓ Securely loaded from .env (Active)';
        label.style.color = 'var(--success)';
      } else {
        label.textContent = 'No key in .env. Enter your key above.';
      }
    }
  } catch (e) {}
}

function saveSettings() {
  const defaultModel = document.getElementById('settings-model-default').value;
  document.getElementById('chat-model-select').value = defaultModel;
  closeSettingsModal();
  showToast('Settings saved successfully');
}

function resetLocalStorage() {
  if (confirm('Clear local cache and reload fresh stories?')) {
    localStorage.removeItem('nbl_lab_notes');
    state.sources = [];
    state.activeSourceIds.clear();
    fetchLiveNewsStream(true);
    showToast('Local database reset');
  }
}

// ══════════════════════════════════════════════════════════════
// UI EVENT LISTENERS
// ══════════════════════════════════════════════════════════════

function setupUIEventListeners() {
  // Collapsible panels
  const app = document.getElementById('app');
  document.getElementById('btn-toggle-sidebar').addEventListener('click', () => {
    app.classList.toggle('sidebar-collapsed');
  });
  document.getElementById('btn-toggle-sidepanel').addEventListener('click', () => {
    app.classList.toggle('sidepanel-collapsed');
  });

  // Theme toggle
  document.getElementById('btn-theme-toggle').addEventListener('click', toggleTheme);

  // Modals
  document.getElementById('btn-open-signin').addEventListener('click', openSignInModal);
  document.getElementById('btn-toggle-account-flyout').addEventListener('click', toggleGoogleAccountFlyout);
  document.getElementById('btn-open-live').addEventListener('click', openLiveModal);
  document.getElementById('btn-header-add-source').addEventListener('click', openUploadModal);
  document.getElementById('btn-sidebar-add').addEventListener('click', openUploadModal);
  document.getElementById('btn-settings-open').addEventListener('click', openSettingsModal);
  document.getElementById('btn-sync-news').addEventListener('click', () => fetchLiveNewsStream(true));

  // Category filter pills
  document.querySelectorAll('.cat-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      state.filterCategory = pill.getAttribute('data-category');
      renderSources();
    });
  });

  // Search input
  const searchInput = document.getElementById('search-input');
  searchInput.addEventListener('input', (e) => {
    state.searchQuery = e.target.value.trim();
    renderSources();
  });

  // Copy document text
  document.getElementById('btn-copy-doc').addEventListener('click', () => {
    const doc = state.sources.find(s => s.id === state.selectedDocId);
    if (doc?.content) {
      navigator.clipboard.writeText(doc.content);
      showToast('Document text copied to clipboard');
    }
  });

  // Audio overview podcast synthesis
  document.getElementById('btn-podcast-overview').addEventListener('click', generateAudioOverview);
}

// ══════════════════════════════════════════════════════════════
// AUDIO OVERVIEW (PODCAST SYNTHESIZER)
// ══════════════════════════════════════════════════════════════

function generateAudioOverview() {
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  if (activeSources.length === 0) {
    showToast('Select at least 1 active source for Audio Overview');
    return;
  }

  showToast('Generating Audio Overview Podcast...');
  const prompt = `Synthesize an engaging spoken deep dive (podcast host style) summarizing key takeaways across the active sources: ${activeSources.map(s => s.title).join('; ')}.`;
  
  appendChatMessage('user', `Generate an Audio Overview summarizing the ${activeSources.length} active research sources.`);
  
  const thinkingId = appendChatThinking();

  fetch('/api/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'gemini-3.5-flash-lite',
      contents: [{ role: 'user', parts: [{ text: prompt }] }]
    })
  }).then(r => r.json()).then(data => {
    removeChatThinking(thinkingId);
    const script = data.candidates?.[0]?.content?.parts?.[0]?.text || 'Audio Overview complete.';
    appendChatMessage('ai', `🎙️ **Audio Overview Synthesis:**\n\n${script}`);

    // If Web Speech API is supported, speak the overview
    if ('speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(script.slice(0, 300));
      utterance.rate = 1.05;
      window.speechSynthesis.speak(utterance);
      showToast('Playing spoken audio overview');
    }
  }).catch(err => {
    removeChatThinking(thinkingId);
    appendChatMessage('ai', `Could not generate audio overview: ${err.message}`);
  });
}

// ══════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════

function escapeHTML(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function showToast(msg) {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = 'toast-item';
  toast.textContent = msg;
  container.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(10px)';
    toast.style.transition = 'all 200ms ease';
    setTimeout(() => toast.remove(), 200);
  }, 3200);
}
</script>

</body>
</html>
