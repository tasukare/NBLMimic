}

// Keyboard Esc handler & Global clicks
window.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeAuthModal();
    closeAddSourceModal();
    closeLiveDialog();
    closeSettings();
    closeDriveModal();
    document.getElementById('user-popover-menu').classList.remove('active');
  }
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault();
    document.getElementById('global-search').focus();
  }
});

document.addEventListener('click', (e) => {
  const popover = document.getElementById('user-popover-menu');
  const trigger = document.getElementById('btn-profile-popover-trigger');
  if (popover?.classList.contains('active')) {
    if (!popover.contains(e.target) && !trigger?.contains(e.target)) {
      popover.classList.remove('active');
    }
  }
});

// ══════════════════════════════════════════════════════════════
// GOOGLE DRIVE FILES EXPLORER & SOURCES
// ══════════════════════════════════════════════════════════════

function getFileCategory(mimeType, fileName = '') {
  const name = (fileName || '').toLowerCase();
  if (mimeType === 'application/vnd.google-apps.document' || name.endsWith('.docx') || name.endsWith('.doc')) {
    return 'Docs';
  }
  if (mimeType === 'application/pdf' || name.endsWith('.pdf')) {
    return 'PDFs';
  }
  if (mimeType === 'application/vnd.google-apps.spreadsheet' || name.endsWith('.xlsx') || name.endsWith('.csv')) {
    return 'Sheets';
  }
  if (name.endsWith('.md') || name.endsWith('.txt') || name.endsWith('.json') || (mimeType && mimeType.startsWith('text/'))) {
    return 'Notes';
  }
  return 'Docs';
}

function getFileTypeBadge(mimeType, fileName = '') {
  const cat = getFileCategory(mimeType, fileName);
  if (cat === 'Docs') return { label: 'DOC', cls: 'badge-doc' };
  if (cat === 'PDFs') return { label: 'PDF', cls: 'badge-pdf' };
  if (cat === 'Sheets') return { label: 'SHEET', cls: 'badge-sheet' };
  if (cat === 'Notes') return { label: 'NOTE', cls: 'badge-note' };
  return { label: 'FILE', cls: 'badge-file' };
}

async function loadGoogleDriveFiles(force = false) {
  const icon = document.getElementById('icon-sync-spin');
  if (icon) icon.style.animation = 'spin 700ms linear infinite';

  if (!state.isDriveConnected || !state.driveToken) {
    if (icon) icon.style.animation = '';
    renderSources();
    return;
  }

  try {
    const q = "trashed = false and mimeType != 'application/vnd.google-apps.folder'";
    const url = `https://www.googleapis.com/drive/v3/files?q=${encodeURIComponent(q)}&pageSize=50&orderBy=modifiedTime desc&fields=files(id,name,mimeType,size,modifiedTime,webViewLink,iconLink)`;

    const res = await fetch(url, {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });

    if (res.status === 401) {
      console.warn('[Drive] Token expired');
      disconnectGoogleDrive();
      if (icon) icon.style.animation = '';
      renderSources();
      return;
    }

    if (res.ok) {
      const data = await res.json();
      const driveFiles = data.files || [];

      // Transform Drive files to notebook sources
      state.sources = driveFiles.map(file => {
        const cat = getFileCategory(file.mimeType, file.name);
        const modDate = file.modifiedTime ? new Date(file.modifiedTime) : new Date();
        const dateStr = modDate.toLocaleDateString([], { month: 'short', day: 'numeric' });
        const sizeStr = file.size ? formatBytes(file.size) : (cat === 'Docs' ? 'Google Doc' : (cat === 'Sheets' ? 'Google Sheet' : 'Cloud File'));

        return {
          id: file.id,
          driveFileId: file.id,
          title: file.name,
          mimeType: file.mimeType,
          category: cat,
          source: 'Google Drive',
          sizeBytes: file.size,
          sizeFormatted: sizeStr,
          webViewLink: file.webViewLink || `https://drive.google.com/file/d/${file.id}/view`,
          url: file.webViewLink || `https://drive.google.com/file/d/${file.id}/view`,
          date: dateStr,
          timestamp: modDate.getTime(),
          excerpt: `${cat} · ${sizeStr} · Modified ${dateStr}`,
          content: null // loaded on demand when clicked or grounded
        };
      });

      // Default ground the first 3 files
      if (state.activeSourceIds.size === 0 && state.sources.length > 0) {
        state.sources.slice(0, 3).forEach(s => state.activeSourceIds.add(s.id));
      }

      renderSources();

      if (!state.selectedDocId && state.sources.length > 0) {
        viewDocument(state.sources[0].id);
      }

      showToast(`Loaded ${state.sources.length} Google Drive files`);
    } else {
      showToast('Could not load Google Drive files');
    }
  } catch (err) {
    console.error('[Drive Files Error]', err);
    showToast(`Error fetching Drive files: ${err.message}`);
  } finally {
    if (icon) icon.style.animation = '';
  }
}

async function fetchDriveDocumentContent(doc) {
  if (!state.driveToken) return 'Please connect Google Drive to read this document.';

  if (doc.mimeType === 'application/vnd.google-apps.document') {
    const res = await fetch(`https://www.googleapis.com/drive/v3/files/${doc.driveFileId}/export?mimeType=text/plain`, {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });
    if (!res.ok) throw new Error(`Google Doc export failed (${res.status})`);
    return await res.text();
  }

  if (doc.mimeType === 'application/vnd.google-apps.spreadsheet') {
    const res = await fetch(`https://www.googleapis.com/drive/v3/files/${doc.driveFileId}/export?mimeType=text/csv`, {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });
    if (!res.ok) throw new Error(`Sheet export failed (${res.status})`);
    const csv = await res.text();
    return `# ${doc.title}\n\nGoogle Spreadsheet (CSV Export):\n\`\`\`csv\n${csv.slice(0, 8000)}\n\`\`\``;
  }

  if (doc.mimeType === 'application/pdf') {
    return `# ${doc.title}\n\n[Google Drive PDF Document]\n\nFile size: ${doc.sizeFormatted || 'Unknown'}\nLast modified: ${doc.date}\n\nClick the "Open in Drive" button in the reader top toolbar to view this PDF directly in Google Drive.`;
  }

  // Text, markdown, JSON, source code
  const res = await fetch(`https://www.googleapis.com/drive/v3/files/${doc.driveFileId}?alt=media`, {
    headers: { Authorization: `Bearer ${state.driveToken}` }
  });
  if (!res.ok) throw new Error(`File download failed (${res.status})`);
  return await res.text();
}

function renderSources() {
  const container = document.getElementById('sources-card-list');
  container.innerHTML = '';

  if (!state.isDriveConnected && state.sources.length === 0) {
    container.innerHTML = `
      <div class="sidebar-drive-connect-hero">
        <div class="drive-hero-icon-wrap">
          <svg width="28" height="28" viewBox="0 0 87.3 78"><path fill="#0066da" d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8H0c0 1.55.4 3.1 1.2 4.5z"/><path fill="#00ac47" d="M43.65 25 29.9 1.2c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z"/><path fill="#ea4335" d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.5l5.85 10.15z"/><path fill="#00832d" d="M43.65 25 57.4 1.2C56.05.4 54.5 0 52.9 0H34.4c-1.6 0-3.15.4-4.5 1.2z"/><path fill="#2684fc" d="M59.8 53H27.5L13.75 76.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.4 4.5-1.2z"/><path fill="#ffba00" d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3L43.65 25l16.15 28h27.5c0-1.55-.4-3.1-1.2-4.5z"/></svg>
        </div>
        <div class="drive-hero-title">Google Drive Files</div>
        <p class="drive-hero-text">Connect your Google Drive to load your research documents, papers, and notes directly into this notebook.</p>
        <button class="btn-primary-auth-action" onclick="connectGoogleDrive()" style="height:34px; font-size:12.5px; font-weight:600; margin-top:8px;">
          Connect Google Drive
        </button>
      </div>
    `;
    document.getElementById('badge-total-sources').textContent = '0';
    document.getElementById('sources-grounding-count').textContent = '0 sources in context';
    return;
  }

  const filtered = state.sources.filter(source => {
    if (state.filterCategory && state.filterCategory !== 'all') {
      const cat = state.filterCategory.toLowerCase();
      const title = (source.title || '').toLowerCase();
      const srcCat = (source.category || '').toLowerCase();
      const srcType = (source.mimeType || '').toLowerCase();
      const excerpt = (source.excerpt || '').toLowerCase();
      const combined = `${title} ${srcCat} ${srcType} ${excerpt}`;

      let matches = false;

      if (cat === 'google drive') {
        matches = source.source === 'Google Drive';
      } else if (cat === 'docs') {
        matches = srcCat === 'docs' || srcType.includes('document') || title.endsWith('.doc') || title.endsWith('.docx');
      } else if (cat === 'sheets') {
        matches = srcCat === 'sheets' || srcType.includes('spreadsheet') || title.endsWith('.xls') || title.endsWith('.xlsx') || title.endsWith('.csv');
      } else if (cat === 'pdfs') {
        matches = srcCat === 'pdfs' || srcType.includes('pdf') || title.endsWith('.pdf');
      } else if (cat === 'notes') {
        matches = srcCat === 'notes' || srcCat.includes('note') || title.endsWith('.md') || title.endsWith('.txt');
      } else if (cat === 'drafts') {
        matches = title.includes('draft') || srcCat.includes('draft') || source.type === 'note';
      } else if (cat === 'ai & ml') {
        const kws = ['ai', 'ml', 'neural', 'gpt', 'llm', 'gemini', 'model', 'vision', 'transformer', 'agent', 'deep', 'learning', 'embedding', 'prompt', 'algorithm', 'weights', 'inference'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat === 'tech') {
        const kws = ['tech', 'software', 'dev', 'code', 'python', 'javascript', 'system', 'cloud', 'database', 'server', 'api', 'git', 'web', 'data', 'architecture', 'engineering'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat === 'science') {
        const kws = ['science', 'physics', 'bio', 'chem', 'quantum', 'nature', 'experiment', 'lab', 'cell', 'particle', 'energy', 'astronomy'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat === 'business') {
        const kws = ['business', 'market', 'finance', 'revenue', 'startup', 'strategy', 'venture', 'pitch', 'invest', 'budget', 'growth', 'sales', 'metrics', 'deck'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat === 'research') {
        const kws = ['research', 'paper', 'study', 'arxiv', 'journal', 'thesis', 'survey', 'analysis', 'benchmark', 'review', 'method', 'abstract'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat.includes('bio') || cat.includes('genetics')) {
        const kws = ['bio', 'gene', 'crispr', 'dna', 'rna', 'protein', 'cell', 'genom', 'medic', 'pharma', 'clinic'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat.includes('physics') || cat.includes('quantum')) {
        const kws = ['physics', 'quantum', 'qubit', 'relativity', 'optics', 'particle', 'gravity', 'mechanics', 'superconductor'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat.includes('finance') || cat.includes('market')) {
        const kws = ['finance', 'market', 'stock', 'crypto', 'asset', 'macro', 'econ', 'portfolio', 'fund', 'trading'];
        matches = kws.some(k => combined.includes(k));
      } else if (cat === 'philosophy') {
        const kws = ['philosophy', 'ethics', 'logic', 'epistem', 'mind', 'conscious', 'reason', 'cognit'];
        matches = kws.some(k => combined.includes(k));
      } else {
        matches = srcCat.includes(cat) || title.includes(cat);
      }

      if (!matches) return false;
    }
    if (state.searchQuery) {
      const q = state.searchQuery.toLowerCase();
      const match = (source.title || '').toLowerCase().includes(q) ||
                    (source.excerpt || '').toLowerCase().includes(q) ||
                    (source.content || '').toLowerCase().includes(q);
      if (!match) return false;
    }
    return true;
  });

  document.getElementById('badge-total-sources').textContent = state.sources.length;
  document.getElementById('sources-grounding-count').textContent = `${state.activeSourceIds.size} sources in context`;

  if (filtered.length === 0) {
    const activeCat = state.filterCategory && state.filterCategory !== 'all' ? state.filterCategory : '';
    container.innerHTML = `
      <div style="text-align:center; padding:36px 16px; color:var(--text-tertiary); animation: cardEntrance 200ms ease forwards;">
        <div style="font-size:13px; font-weight:600; color:var(--text-secondary); margin-bottom:4px;">No documents in ${escapeHtml(activeCat || 'view')}</div>
        <p style="font-size:11.5px; max-width:220px; margin:0 auto 12px; line-height:1.4;">Add research notes or papers tagged with this topic.</p>
        <button class="btn-tiny-action" style="margin:0 auto; height:28px; padding:0 12px; font-weight:500;" onclick="openAddSourceModal()">+ Add ${escapeHtml(activeCat || 'Source')}</button>
      </div>
    `;
    return;
  }

  filtered.forEach((source, idx) => {
    const isChecked = state.activeSourceIds.has(source.id);
    const isSelected = state.selectedDocId === source.id;
    const badgeInfo = getFileTypeBadge(source.mimeType, source.title);

    const card = document.createElement('div');
    card.className = `source-item-card ${isSelected ? 'selected' : ''}`;
    card.style.animationDelay = `${Math.min(idx * 30, 240)}ms`;
    card.onclick = (e) => {
      if (e.target.type !== 'checkbox') {
        viewDocument(source.id);
      }
    };

    card.innerHTML = `
      <div class="source-item-header">
        <span class="source-pill-badge ${badgeInfo.cls}">${badgeInfo.label}</span>
        <label class="source-check-wrap" title="Include in Grounded Context">
          <input type="checkbox" class="source-check" ${isChecked ? 'checked' : ''} onchange="toggleGrounding('${source.id}', this.checked)">
        </label>
      </div>
      <div class="source-item-title">${escapeHtml(source.title)}</div>
      <div class="source-item-snippet">${escapeHtml(source.excerpt || source.sizeFormatted || 'Google Drive File')}</div>
      <div class="source-item-meta">
        <span>${escapeHtml(source.source || 'Google Drive')}</span>
        <span>${escapeHtml(source.date || 'Today')}</span>
      </div>
    `;

    container.appendChild(card);
  });
}

function toggleGrounding(id, checked) {
  if (checked) state.activeSourceIds.add(id);
  else state.activeSourceIds.delete(id);

  document.getElementById('sources-grounding-count').textContent = `${state.activeSourceIds.size} sources in context`;
  updateGroundedBadge();
}

async function viewDocument(id) {
  state.selectedDocId = id;
  const doc = state.sources.find(s => s.id === id);
  if (!doc) return;

  renderSources();

  // If content is null, fetch content from Drive
  if (doc.content === null) {
    const container = document.getElementById('reader-main-content');
    container.innerHTML = `
      <div style="padding:60px 0; text-align:center; color:var(--text-tertiary);">
        <div style="font-size:15px; font-weight:600; color:var(--text-main); margin-bottom:8px;">Loading from Google Drive...</div>
        <p style="font-size:12.5px; max-width:320px; margin:0 auto;">Fetching content for <strong>${escapeHtml(doc.title)}</strong></p>
      </div>
    `;
    try {
      doc.content = await fetchDriveDocumentContent(doc);
    } catch (err) {
      doc.content = `# ${doc.title}\n\nCould not fetch file content from Google Drive.\n\nError: ${err.message}\n\nYou can open the file directly in Google Drive using the button in the top right.`;
    }
  }

  renderReader(doc);
}

function renderReader(doc) {
  const container = document.getElementById('reader-main-content');
  const extBtn = document.getElementById('btn-open-original-link');

  if (doc.url || doc.webViewLink) {
    extBtn.style.display = 'inline-flex';
    extBtn.onclick = () => window.open(doc.webViewLink || doc.url, '_blank');
  } else {
    extBtn.style.display = 'none';
  }

  const words = (doc.content || '').split(/\s+/).filter(Boolean).length;
  const readMin = Math.ceil(words / 200) || 1;

  container.innerHTML = `
    <article class="reader-prose-animate">
      <div class="reader-article-header">
        <div class="reader-article-category">${escapeHtml(doc.category || 'Google Drive')}</div>
        <h1 class="reader-article-title">${escapeHtml(doc.title)}</h1>
        <div class="reader-article-meta">
          <span>${readMin} min read</span>
          <span>&bull;</span>
          <span>${words} words</span>
          <span>&bull;</span>
          <span>Source: ${escapeHtml(doc.source || 'Google Drive')}</span>
          <span>&bull;</span>
          <span>Size: ${escapeHtml(doc.sizeFormatted || 'Cloud')}</span>
        </div>
      </div>
      <div class="reader-prose-content">
        ${formatProse(doc.content || '')}
      </div>
    </article>
  `;

  updateGroundedBadge();
}

function updateGroundedBadge() {
  const badge = document.getElementById('reader-grounded-badge');
  if (!state.selectedDocId) {
    badge.style.display = 'none';
    return;
  }
  const isGrounded = state.activeSourceIds.has(state.selectedDocId);
  badge.style.display = 'inline-flex';
  if (isGrounded) {
    badge.style.color = 'var(--success)';
    badge.style.background = 'var(--success-subtle)';
    badge.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Included in Notebook Context</span>`;
  } else {
    badge.style.color = 'var(--text-tertiary)';
    badge.style.background = 'var(--bg-subtle)';
    badge.innerHTML = `<span>Not in active context</span>`;
  }
}

function formatProse(text) {
  if (!text) return '';
  return text.split(/\n\n+/).map(block => {
    const trimmed = block.trim();
    if (trimmed.startsWith('# ')) return `<h2>${escapeHtml(trimmed.slice(2))}</h2>`;
    if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
      const items = trimmed.split('\n').map(li => `<li>${escapeHtml(li.replace(/^[-*]\s+/, ''))}</li>`).join('');
      return `<ul>${items}</ul>`;
    }
    return `<p>${escapeHtml(trimmed)}</p>`;
  }).join('');
}

// ══════════════════════════════════════════════════════════════
// GROUNDED AI CHAT & GEMINI DEV (gemini-api-dev)
// ══════════════════════════════════════════════════════════════

document.getElementById('chat-submit-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('chat-textarea');
  const text = input.value.trim();
  if (!text) return;

  addMessage('user', text);
  input.value = '';
  input.style.height = 'auto';

  // Grounding sources payload
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  for (const src of activeSources) {
    if (src.content === null && src.driveFileId && state.driveToken) {
      try {
        src.content = await fetchDriveDocumentContent(src);
      } catch (e) {}
    }
  }

  let context = '';
  if (activeSources.length > 0) {
    activeSources.forEach((src, idx) => {
      const body = src.content || src.excerpt || '';
      context += `[Source ${idx + 1}: "${src.title}"]\n${body.slice(0, 15000)}\n\n`;
    });
  }

  const systemInstruction = activeSources.length > 0
    ? `You are an elite research partner inside Research Lab (NBLMimic).
Synthesize and answer questions accurately grounded in the active sources provided below.
Cite your specific claims with strict numbered bracket notation like [1], [2], corresponding to the source number.
If information is not contained in the sources, mention that clearly, and then optionally provide helpful context based on general scientific knowledge.`
    : `You are an elite research partner inside Research Lab (NBLMimic).
Help the researcher brainstorm, explore concepts, summarize information, and plan experiments with rigorous depth.`;

  const thinkingId = addThinking();
  const model = document.getElementById('select-active-model').value || 'gemini-3.5-flash-lite';

  try {
    let reply = '';
    let proxyFailed = false;

    // 1. Primary: Call local proxy server /api/chat
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model,
          apiKey: state.geminiApiKey,
          system_instruction: { parts: [{ text: systemInstruction }] },
          contents: [
            { role: 'user', parts: [{ text: activeSources.length > 0 ? `SOURCES:\n${context}\n\nQUESTION:\n${text}` : text }] }
          ]
        })
      });

      if (res.ok) {
        const data = await res.json();
        reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'No response generated.';
      } else {
        const err = await res.json().catch(() => ({}));
        reply = `Error: ${err.error?.message || 'Server error occurred'}`;
      }
    } catch (fetchErr) {
      proxyFailed = true;
    }

    // 2. Secondary fallback: If proxy unreachable (e.g. running from file://), call Google directly
    if (proxyFailed) {
      const key = state.geminiApiKey || localStorage.getItem('gemini_api_key');
      if (!key) {
        removeThinking(thinkingId);
        addMessage('ai', `Connection error: Server is not running, and no Gemini API Key is stored. Please run \`node server.js\` or enter your key in Settings.`);
        return;
      }

      const directUrl = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(key)}`;
      const directRes = await fetch(directUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          system_instruction: { parts: [{ text: systemInstruction }] },
          contents: [
            { role: 'user', parts: [{ text: activeSources.length > 0 ? `SOURCES:\n${context}\n\nQUESTION:\n${text}` : text }] }
          ]
        })
      });

      if (directRes.ok) {
        const data = await directRes.json();
        reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'No response generated.';
      } else {
        const err = await directRes.json().catch(() => ({}));
        reply = `Google API Error (${directRes.status}): ${err.error?.message || 'Direct call failed'}`;
      }
    }

    removeThinking(thinkingId);
    addMessage('ai', reply);

  } catch (err) {
    removeThinking(thinkingId);
    addMessage('ai', `Connection error: ${err.message}.`);
  }
});

function addMessage(role, text) {
  const container = document.getElementById('chat-messages-stream');
  const div = document.createElement('div');
  div.className = `chat-msg ${role}`;

  if (role === 'ai') {
    let html = escapeHtml(text);
    // Citations
    html = html.replace(/\[(\d+)\]/g, (m, p1) => {
      return `<button class="citation-anchor" onclick="navigateToCitation(${p1})">[${p1}]</button>`;
    });
    // Bold & Italics
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
    // Code blocks & inline code
    html = html.replace(/```([\s\S]*?)```/g, '<pre style="background:var(--bg-subtle); padding:8px 12px; border-radius:6px; font-family:var(--font-mono); font-size:11.5px; margin:6px 0; overflow-x:auto;"><code>$1</code></pre>');
    html = html.replace(/`([^`]+)`/g, '<code style="background:var(--bg-subtle); padding:1px 4px; border-radius:3px; font-family:var(--font-mono); font-size:11.5px;">$1</code>');
    // Line breaks
    html = html.replace(/\n/g, '<br>');
    div.innerHTML = html;
  } else {
    div.textContent = text;
  }

  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function addThinking() {
  const container = document.getElementById('chat-messages-stream');
  const id = 'think-' + Date.now();
  const div = document.createElement('div');
  div.className = 'chat-msg ai';
  div.id = id;
  div.style.color = 'var(--text-tertiary)';
  div.style.fontStyle = 'italic';
  div.textContent = 'Synthesizing sources...';
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
  return id;
}

function removeThinking(id) {
  const el = document.getElementById(id);
  if (el) el.remove();
}

function navigateToCitation(index) {
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  const doc = activeSources[index - 1];
  if (doc) {
    viewDocument(doc.id);
    showToast(`Jumped to citation [${index}]: ${doc.title}`);
  }
}

function sendQuickPrompt(prompt) {
  document.getElementById('chat-textarea').value = prompt;
  document.getElementById('chat-submit-form').dispatchEvent(new Event('submit'));
}

function clearChat() {
  document.getElementById('chat-messages-stream').innerHTML = `
    <div class="chat-msg ai">
      Chat cleared. How can I assist with your research?
    </div>
  `;
}

// Quick speech dictation inside chat box
let chatSpeechRec = null;
let isChatDictating = false;

function toggleChatDictation() {
  const micBtn = document.getElementById('btn-chat-mic-dictate');
  const textarea = document.getElementById('chat-textarea');

  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRec) {
    openLiveDialog();
    showToast('Opened Gemini 3.8 Live Spoken Assistant');
    return;
  }

  if (isChatDictating) {
    if (chatSpeechRec) chatSpeechRec.stop();
    isChatDictating = false;
    if (micBtn) micBtn.classList.remove('active');
    showToast('Dictation stopped');
    return;
  }

  try {
    chatSpeechRec = new SpeechRec();
    chatSpeechRec.continuous = true;
    chatSpeechRec.interimResults = true;
    chatSpeechRec.lang = 'en-US';

    chatSpeechRec.onstart = () => {
      isChatDictating = true;
      if (micBtn) micBtn.classList.add('active');
      showToast('Listening... Speak your prompt');
    };

    chatSpeechRec.onresult = (evt) => {
      let finalTranscript = '';
      for (let i = evt.resultIndex; i < evt.results.length; ++i) {
        if (evt.results[i].isFinal) {
          finalTranscript += evt.results[i][0].transcript;
        }
      }
      if (finalTranscript) {
        textarea.value = (textarea.value ? textarea.value + ' ' : '') + finalTranscript;
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
      }
    };

    chatSpeechRec.onerror = (err) => {
      console.warn('Dictation error:', err);
      isChatDictating = false;
      if (micBtn) micBtn.classList.remove('active');
    };

    chatSpeechRec.onend = () => {
      isChatDictating = false;
      if (micBtn) micBtn.classList.remove('active');
    };

    chatSpeechRec.start();
  } catch (err) {
    console.error('Dictation start failed:', err);
    openLiveDialog();
  }
}

// ══════════════════════════════════════════════════════════════
// LAB NOTES & SCRATCHPAD
// ══════════════════════════════════════════════════════════════

const notesPad = document.getElementById('notes-pad');
let driveSyncDebounceTimer = null;

notesPad.addEventListener('input', () => {
  state.notesContent = notesPad.value;
  localStorage.setItem('nbl_lab_notes', state.notesContent);
  updateNotesWordCount();

  if (state.isDriveConnected) {
    const notesStatusLabel = document.getElementById('notes-status-label');
    if (notesStatusLabel) notesStatusLabel.textContent = 'Unsynced edits...';
    clearTimeout(driveSyncDebounceTimer);
    driveSyncDebounceTimer = setTimeout(() => {
      syncCurrentNotesToDrive(true);
    }, 2500);
  }
});

function initNotes() {
  const saved = localStorage.getItem('nbl_lab_notes');
  if (saved) {
    state.notesContent = saved;
    notesPad.value = saved;
    updateNotesWordCount();
  }
}

function updateNotesWordCount() {
  const count = state.notesContent.trim().split(/\s+/).filter(Boolean).length;
  document.getElementById('notes-word-counter').textContent = `${count} words`;
}

function copyNotes() {
  navigator.clipboard.writeText(notesPad.value);
  showToast('Notes copied to clipboard');
}

function downloadNotes() {
  const blob = new Blob([notesPad.value], { type: 'text/markdown;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `Lab_Notes_${new Date().toISOString().slice(0, 10)}.md`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('Exported notes as Markdown file');
}

function setPanelTab(tab) {
  state.currentTab = tab;
  document.getElementById('tab-btn-chat').classList.toggle('active', tab === 'chat');
  document.getElementById('tab-btn-notes').classList.toggle('active', tab === 'notes');
  document.getElementById('tab-view-chat').style.display = tab === 'chat' ? 'flex' : 'none';
  document.getElementById('tab-view-notes').style.display = tab === 'notes' ? 'flex' : 'none';
}

// ══════════════════════════════════════════════════════════════
// MANUAL UPLOADS & SOURCES
// ══════════════════════════════════════════════════════════════

function submitManualSource() {
  const title = document.getElementById('manual-doc-title').value.trim();
  const content = document.getElementById('manual-doc-content').value.trim();
  if (!title || !content) {
    showToast('Please enter title and content');
    return;
  }

  const newDoc = {
    id: Date.now(),
    type: 'note',
    title,
    source: 'My Notebook',
    category: 'Notes & Uploads',
    excerpt: content.slice(0, 140) + '…',
    content,
    date: 'Just now',
    timestamp: Date.now()
  };

  state.sources.unshift(newDoc);
  state.activeSourceIds.add(newDoc.id);
  renderSources();
  viewDocument(newDoc.id);
  closeAddSourceModal();
  document.getElementById('manual-doc-title').value = '';
  document.getElementById('manual-doc-content').value = '';
  showToast('Document added to notebook');
}

document.getElementById('input-file-select').addEventListener('change', (e) => {
  if (e.target.files?.length) {
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = (evt) => {
      const text = evt.target.result;
      const newDoc = {
        id: Date.now(),
        type: 'upload',
        title: file.name,
        source: 'Upload',
        category: 'Notes & Uploads',
        excerpt: text.slice(0, 140) + '…',
        content: text,
        date: 'Just now',
        timestamp: Date.now()
      };
      state.sources.unshift(newDoc);
      state.activeSourceIds.add(newDoc.id);
      renderSources();
      viewDocument(newDoc.id);
      closeAddSourceModal();
      showToast(`Uploaded ${file.name}`);
    };
    reader.readAsText(file);
  }
});

// ══════════════════════════════════════════════════════════════
// GEMINI 3.8 LIVE AUDIO & WEBSOCKET ENGINE (gemini-live-api-dev)
// ══════════════════════════════════════════════════════════════

let liveWs = null;
let liveOutAudioCtx = null;
let liveInAudioCtx = null;
let liveOutAnalyser = null;
let liveInAnalyser = null;
let liveMicStream = null;
let liveMicProcessor = null;
let liveNextPlayTime = 0;
let liveActiveAudioSources = [];
let isLiveMicActive = false;
let isLiveSessionOpen = false;
let liveVisualizerAnimId = null;

// Convert Float32 array from Web Audio API to 16-bit PCM little-endian
function float32To16BitPCM(float32Array) {
  const pcm16 = new Int16Array(float32Array.length);
  for (let i = 0; i < float32Array.length; i++) {
    const s = Math.max(-1, Math.min(1, float32Array[i]));
    pcm16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
  }
  return pcm16;
}

// Convert ArrayBuffer to Base64 string
function bufferToBase64(buffer) {
  let binary = '';
  const bytes = new Uint8Array(buffer);
  const len = bytes.byteLength;
  for (let i = 0; i < len; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  return window.btoa(binary);
}

// Convert base64 PCM 24kHz back to AudioBuffer
function base64ToPCM24kAudioBuffer(ctx, base64Str) {
  const binaryString = window.atob(base64Str);
  const len = binaryString.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++) {
    bytes[i] = binaryString.charCodeAt(i);
  }
  const int16 = new Int16Array(bytes.buffer);
  const float32 = new Float32Array(int16.length);
  for (let i = 0; i < int16.length; i++) {
    float32[i] = int16[i] / 32768.0;
  }
  const audioBuffer = ctx.createBuffer(1, float32.length, 24000);
  audioBuffer.getChannelData(0).set(float32);
  return audioBuffer;
}

// Gapless queued playback
function queueLiveAudioPlayback(base64Pcm) {
  if (!liveOutAudioCtx) {
    liveOutAudioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 24000 });
    liveOutAnalyser = liveOutAudioCtx.createAnalyser();
    liveOutAnalyser.fftSize = 64;
    liveOutAnalyser.connect(liveOutAudioCtx.destination);
  }
  if (liveOutAudioCtx.state === 'suspended') {
    liveOutAudioCtx.resume();
  }

  const audioBuffer = base64ToPCM24kAudioBuffer(liveOutAudioCtx, base64Pcm);
  const source = liveOutAudioCtx.createBufferSource();
  source.buffer = audioBuffer;
  source.connect(liveOutAnalyser);

  const now = liveOutAudioCtx.currentTime;
  if (liveNextPlayTime < now) {
    liveNextPlayTime = now + 0.04;
  }
  source.start(liveNextPlayTime);
  liveNextPlayTime += audioBuffer.duration;

  liveActiveAudioSources.push(source);
  updateInterruptBtnVisibility();

  source.onended = () => {
    const idx = liveActiveAudioSources.indexOf(source);
    if (idx !== -1) liveActiveAudioSources.splice(idx, 1);
    updateInterruptBtnVisibility();
  };
}

function stopLiveAudioPlayback() {
  liveActiveAudioSources.forEach(s => {
    try { s.stop(); } catch (e) {}
  });
  liveActiveAudioSources.length = 0;
  if (liveOutAudioCtx) {
    liveNextPlayTime = liveOutAudioCtx.currentTime;
  }
  updateInterruptBtnVisibility();
}

function updateInterruptBtnVisibility() {
  const btn = document.getElementById('btn-interrupt-live');
  if (btn) {
    btn.style.display = liveActiveAudioSources.length > 0 ? 'inline-flex' : 'none';
  }
}

async function connectGeminiLive() {
  const statusLabel = document.getElementById('voice-status-label');
  const dot = document.getElementById('live-connection-dot');
  const transcript = document.getElementById('voice-transcript');

  // 1. Get API key (from state, localStorage, or server)
  let apiKey = state.geminiApiKey || localStorage.getItem('gemini_api_key') || '';
  if (!apiKey) {
    try {
      const cfg = await fetch('/api/live-config').then(r => r.json());
      if (cfg.apiKey) {
        apiKey = cfg.apiKey;
        state.geminiApiKey = apiKey;
        localStorage.setItem('gemini_api_key', apiKey);
      }
    } catch (e) {}
  }

  if (!apiKey) {
    statusLabel.textContent = 'API key required in Settings or .env';
    transcript.innerHTML = `<div style="color:#ef4444;">⚠️ No Gemini API key detected. Add your GEMINI_API_KEY to .env or click Settings (top right) to enter your API key.</div>`;
    return;
  }

  if (liveWs && (liveWs.readyState === WebSocket.OPEN || liveWs.readyState === WebSocket.CONNECTING)) {
    return;
  }

  statusLabel.textContent = 'Connecting to Gemini 3.8 Live...';
  if (dot) dot.style.background = '#f59e0b';

  const wsUrl = `wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=${encodeURIComponent(apiKey)}`;

  try {
    liveWs = new WebSocket(wsUrl);

    liveWs.onopen = () => {
      console.log('[Live] WebSocket connected to Gemini 3.8 Live');
      statusLabel.textContent = 'Configuring session...';
      if (dot) dot.style.background = '#10b981';

      // Assemble workspace context
      const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
      let context = '';
      activeSources.slice(0, 4).forEach((s, idx) => {
        context += `[Source ${idx+1}: "${s.title}"]\n${(s.content || s.excerpt || '').slice(0, 1000)}\n\n`;
      });

      const instruction = `You are a real-time, highly intelligent research partner inside NBLMimic.
Keep your spoken responses natural, concise (1-3 spoken sentences), and direct.
If the researcher asks about their documents, refer to the active research context:
${context || 'No specific sources are active right now.'}`;

      const setupMsg = {
        setup: {
          model: 'models/gemini-3.8-live',
          generationConfig: {
            responseModalities: ['AUDIO']
          },
          systemInstruction: {
            parts: [{ text: instruction }]
          }
        }
      };

      liveWs.send(JSON.stringify(setupMsg));
    };

    liveWs.onmessage = async (event) => {
      try {
        const raw = typeof event.data === 'string' ? event.data : await event.data.text();
        const msg = JSON.parse(raw);

        if (msg.setupComplete) {
          console.log('[Live] Setup complete');
          statusLabel.textContent = isLiveMicActive ? 'Listening (mic active)...' : 'Connected. Tap mic or type below.';
          if (dot) dot.style.background = '#10b981';
          return;
        }

        if (msg.serverContent) {
          const sc = msg.serverContent;

          if (sc.interrupted) {
            console.log('[Live] Model generation interrupted by user');
            stopLiveAudioPlayback();
            statusLabel.textContent = 'Listening (interrupted)...';
            appendLiveTranscript('Gemini', '<em>[Spoken response interrupted]</em>', '#a1a1aa');
            return;
          }

          if (sc.modelTurn?.parts) {
            for (const part of sc.modelTurn.parts) {
              if (part.inlineData?.data) {
                queueLiveAudioPlayback(part.inlineData.data);
                statusLabel.textContent = 'Gemini speaking...';
                if (dot) dot.style.background = '#38bdf8';
              }
              if (part.text) {
                appendLiveTranscript('Gemini', part.text, '#38bdf8');
              }
            }
          }

          if (sc.outputTranscription?.text) {
            appendLiveTranscript('Gemini', sc.outputTranscription.text, '#38bdf8');
          }

          if (sc.inputTranscription?.text) {
            appendLiveTranscript('You', sc.inputTranscription.text, '#f4f4f5');
          }

          if (sc.turnComplete) {
            statusLabel.textContent = isLiveMicActive ? 'Listening...' : 'Ready. Tap mic to speak.';
            if (dot) dot.style.background = '#10b981';
          }
        }
      } catch (err) {
        console.error('[Live] Message parsing error:', err);
      }
    };

    liveWs.onerror = (err) => {
      console.error('[Live] WebSocket error:', err);
      statusLabel.textContent = 'Connection error. Check API key.';
      if (dot) dot.style.background = '#ef4444';
    };

    liveWs.onclose = (ev) => {
      console.log('[Live] WebSocket closed:', ev.code, ev.reason);
      statusLabel.textContent = 'Live session disconnected. Tap to reconnect.';
      if (dot) dot.style.background = '#71717a';
      stopLiveAudioPlayback();
      stopMicCapture();
    };

  } catch (err) {
    console.error('[Live] Connection failed:', err);
    statusLabel.textContent = `Connection error: ${err.message}`;
  }
}

async function startMicCapture() {
  try {
    liveMicStream = await navigator.mediaDevices.getUserMedia({
      audio: {
        sampleRate: 16000,
        channelCount: 1,
        echoCancellation: true,
        noiseSuppression: true,
        autoGainControl: true
      }
    });

    liveInAudioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
    liveInAnalyser = liveInAudioCtx.createAnalyser();
    liveInAnalyser.fftSize = 64;

    const source = liveInAudioCtx.createMediaStreamSource(liveMicStream);
    source.connect(liveInAnalyser);

    // Buffer size 2048 at 16000Hz = ~128ms chunks
    liveMicProcessor = liveInAudioCtx.createScriptProcessor(2048, 1, 1);
    liveMicProcessor.onaudioprocess = (e) => {
      if (!isLiveMicActive) return;
      if (!liveWs || liveWs.readyState !== WebSocket.OPEN) return;

      const inputFloats = e.inputBuffer.getChannelData(0);
      const pcm16 = float32To16BitPCM(inputFloats);
      const b64 = bufferToBase64(pcm16.buffer);

      liveWs.send(JSON.stringify({
        realtimeInput: {
          audio: {
            data: b64,
            mimeType: 'audio/pcm;rate=16000'
          }
        }
      }));
    };

    source.connect(liveMicProcessor);
    liveMicProcessor.connect(liveInAudioCtx.destination);

    isLiveMicActive = true;
    const btn = document.getElementById('btn-toggle-voice-stream');
    if (btn) btn.classList.add('active');
    document.getElementById('voice-status-label').textContent = 'Listening to your microphone...';

  } catch (err) {
    console.error('[Live] Mic access error:', err);
    isLiveMicActive = false;
    document.getElementById('voice-status-label').textContent = 'Microphone permission denied. You can type below.';
    showToast('Microphone access blocked. Use the text input below to converse.');
  }
}

function stopMicCapture() {
  isLiveMicActive = false;
  if (liveMicStream) {
    liveMicStream.getTracks().forEach(t => t.stop());
    liveMicStream = null;
  }
  if (liveMicProcessor) {
    try { liveMicProcessor.disconnect(); } catch (e) {}
    liveMicProcessor = null;
  }
  if (liveInAudioCtx) {
    try { liveInAudioCtx.close(); } catch (e) {}
    liveInAudioCtx = null;
  }
  const btn = document.getElementById('btn-toggle-voice-stream');
  if (btn) btn.classList.remove('active');
  document.getElementById('voice-status-label').textContent = 'Microphone muted. Tap to speak.';
}

function toggleLiveMic() {
  if (isLiveMicActive) {
    stopMicCapture();
  } else {
    if (!liveWs || liveWs.readyState !== WebSocket.OPEN) {
      connectGeminiLive();
    }
    startMicCapture();
  }
}

function sendLiveTextMessage(e) {
  if (e) e.preventDefault();
  const input = document.getElementById('live-text-input');
  const text = (input ? input.value : '').trim();
  if (!text) return;

  if (!liveWs || liveWs.readyState !== WebSocket.OPEN) {
    connectGeminiLive();
    showToast('Reconnecting Gemini Live session...');
    return;
  }

  appendLiveTranscript('You', text, '#f4f4f5');
  input.value = '';
  document.getElementById('voice-status-label').textContent = 'Synthesizing response...';

  liveWs.send(JSON.stringify({
    realtimeInput: {
      text: text
    }
  }));
}

function interruptLivePlayback() {
  stopLiveAudioPlayback();
  appendLiveTranscript('System', 'Playback interrupted', '#f59e0b');
  document.getElementById('voice-status-label').textContent = isLiveMicActive ? 'Listening...' : 'Ready.';
}

function appendLiveTranscript(sender, text, color) {
  const container = document.getElementById('voice-transcript');
  if (!container) return;

  // Clear initial placeholder if present
  if (container.querySelector('em') || container.querySelector('div')?.style?.color === 'rgb(113, 113, 122)') {
    container.innerHTML = '';
  }

  const p = document.createElement('div');
  p.style.marginBottom = '6px';
  p.style.lineHeight = '1.45';
  p.innerHTML = `<strong style="color:${color || '#fff'}; font-size:11.5px;">${escapeHtml(sender)}:</strong> <span style="color:#d4d4d8;">${escapeHtml(text)}</span>`;
  container.appendChild(p);
  container.scrollTop = container.scrollHeight;
}

function startRealVoiceWave() {
  const canvas = document.getElementById('voice-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const width = canvas.width;
  const height = canvas.height;
  const midY = height / 2;

  const freqData = new Uint8Array(32);

  function draw() {
    liveVisualizerAnimId = requestAnimationFrame(draw);

    let maxEnergy = 0;
    if (liveOutAnalyser && liveActiveAudioSources.length > 0) {
      liveOutAnalyser.getByteFrequencyData(freqData);
    } else if (liveInAnalyser && isLiveMicActive) {
      liveInAnalyser.getByteFrequencyData(freqData);
    } else {
      freqData.fill(0);
    }

    for (let i = 0; i < freqData.length; i++) {
      if (freqData[i] > maxEnergy) maxEnergy = freqData[i];
    }
    const energyRatio = maxEnergy / 255; // 0.0 to 1.0

    ctx.clearRect(0, 0, width, height);

    const waves = [
      { color: 'rgba(56, 189, 248, 0.85)', baseAmp: 4, dynamicAmp: 32, freq: 0.025, speed: 0.003 },
      { color: 'rgba(129, 140, 248, 0.75)', baseAmp: 3, dynamicAmp: 24, freq: 0.03, speed: 0.004 },
      { color: 'rgba(192, 132, 252, 0.65)', baseAmp: 2, dynamicAmp: 18, freq: 0.035, speed: 0.002 }
    ];

    const time = performance.now();

    waves.forEach((w, idx) => {
      ctx.beginPath();
      ctx.lineWidth = 1.75;
      ctx.strokeStyle = w.color;

      const currentAmp = w.baseAmp + (w.dynamicAmp * energyRatio);

      for (let x = 0; x <= width; x += 4) {
        const envelope = Math.sin((x / width) * Math.PI);
        const y = midY + Math.sin(x * w.freq + time * w.speed + idx) * currentAmp * envelope;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    });
  }

  if (liveVisualizerAnimId) cancelAnimationFrame(liveVisualizerAnimId);
  draw();
}

function stopRealVoiceWave() {
  if (liveVisualizerAnimId) cancelAnimationFrame(liveVisualizerAnimId);
  liveVisualizerAnimId = null;
}

function openLiveDialog() {
  document.getElementById('live-voice-modal').classList.add('active');
  isLiveSessionOpen = true;

  const count = state.activeSourceIds.size;
  const label = document.getElementById('live-source-context-label');
  if (label) {
    label.textContent = `${count} sources in context`;
  }

  startRealVoiceWave();
  connectGeminiLive();
}

function closeLiveDialog() {
  document.getElementById('live-voice-modal').classList.remove('active');
  isLiveSessionOpen = false;
  stopRealVoiceWave();
  stopMicCapture();
  stopLiveAudioPlayback();
  if (liveWs) {
    try { liveWs.close(); } catch (e) {}
    liveWs = null;
  }
}

// ══════════════════════════════════════════════════════════════
// AUDIO OVERVIEW PODCAST GENERATION
// ══════════════════════════════════════════════════════════════

document.getElementById('btn-trigger-podcast').addEventListener('click', () => {
  const activeSources = state.sources.filter(s => state.activeSourceIds.has(s.id));
  if (activeSources.length === 0) {
    showToast('Select at least 1 source for Audio Overview');
    return;
  }

  showToast('Synthesizing Audio Overview...');
  addMessage('user', `Generate an Audio Overview summarizing the ${activeSources.length} active research sources.`);

  const prompt = `Synthesize an engaging, highly structured spoken deep-dive podcast script reviewing the key takeaways across: ${activeSources.map(s => s.title).join('; ')}.`;
  const thinkingId = addThinking();

  fetch('/api/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'gemini-3.5-flash-lite',
      apiKey: state.geminiApiKey,
      contents: [{ role: 'user', parts: [{ text: prompt }] }]
    })
  }).then(r => r.json()).then(data => {
    removeThinking(thinkingId);
    const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'Overview generated.';
    addMessage('ai', `🎙️ **Audio Overview Synthesis:**\n\n${reply}`);

    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(reply.slice(0, 450));
      u.rate = 1.0;
      window.speechSynthesis.speak(u);
      showToast('Playing spoken overview snippet');
    }
  }).catch(e => {
    removeThinking(thinkingId);
    addMessage('ai', `Could not synthesize audio overview: ${e.message}`);
  });
});

// ══════════════════════════════════════════════════════════════
// THEME & SETTINGS
// ══════════════════════════════════════════════════════════════

function initTheme() {
  const theme = localStorage.getItem('nbl_theme') || 'light';
  setTheme(theme);
}

function setTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  document.getElementById('icon-sun').style.display = theme === 'dark' ? 'block' : 'none';
  document.getElementById('icon-moon').style.display = theme === 'dark' ? 'none' : 'block';
}

function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'dark' ? 'light' : 'dark';
  setTheme(next);
  localStorage.setItem('nbl_theme', next);
}

async function checkHealth() {
  const savedKey = localStorage.getItem('gemini_api_key');
  if (savedKey) {
    state.geminiApiKey = savedKey;
    const input = document.getElementById('setting-gemini-key');
    if (input) input.value = savedKey;
  }

  try {
    const res = await fetch('/api/health');
    if (res.ok) {
      const data = await res.json();
      if (data.hasServerKey && data.apiKey) {
        state.geminiApiKey = data.apiKey;
        localStorage.setItem('gemini_api_key', data.apiKey);
        const statusEl = document.getElementById('setting-key-status');
        if (statusEl) {
          statusEl.textContent = '✓ Securely loaded from .env';
          statusEl.style.color = 'var(--success)';
        }
        const input = document.getElementById('setting-gemini-key');
        if (input && !input.value) input.value = data.apiKey;
      }
    }
  } catch (e) {}
}

function saveSettings() {
  const model = document.getElementById('setting-default-model').value;
  const keyInput = document.getElementById('setting-gemini-key').value.trim();

  state.activeModel = model;
  document.getElementById('select-active-model').value = model;

  if (keyInput) {
    state.geminiApiKey = keyInput;
    localStorage.setItem('gemini_api_key', keyInput);
    const statusEl = document.getElementById('setting-key-status');
    if (statusEl) {
      statusEl.textContent = '✓ API key saved in browser';
      statusEl.style.color = 'var(--success)';
    }
  }

  closeSettings();
  showToast('Settings saved');
}

function resetLocalCache() {
  if (confirm('Reset local cache and reload stories?')) {
    localStorage.removeItem('nbl_lab_notes');
    state.sources = [];
    state.activeSourceIds.clear();
    fetchNewsFeed(true);
    closeSettings();
    showToast('Local database reloaded');
  }
}

// ══════════════════════════════════════════════════════════════
// CATEGORY CAROUSEL & HORIZONTAL NAVIGATION (< >)
// ══════════════════════════════════════════════════════════════

function initCategoryCarousel() {
  const tabsBar = document.getElementById('filter-tabs-bar');
  const prevBtn = document.getElementById('btn-cat-prev');
  const nextBtn = document.getElementById('btn-cat-next');
  const fadeLeft = document.getElementById('cat-fade-left');
  const fadeRight = document.getElementById('cat-fade-right');

  if (!tabsBar || !prevBtn || !nextBtn) return;

  function updateArrows() {
    const scrollLeft = tabsBar.scrollLeft;
    const maxScroll = Math.max(0, tabsBar.scrollWidth - tabsBar.clientWidth);

    const canPrev = scrollLeft > 6;
    const canNext = scrollLeft < maxScroll - 6;

    prevBtn.classList.toggle('disabled', !canPrev);
    prevBtn.disabled = !canPrev;

    nextBtn.classList.toggle('disabled', !canNext);
    nextBtn.disabled = !canNext;

    if (fadeLeft) fadeLeft.style.opacity = canPrev ? '1' : '0';
    if (fadeRight) fadeRight.style.opacity = canNext ? '1' : '0';
  }

  prevBtn.onclick = () => {
    tabsBar.scrollBy({ left: -140, behavior: 'smooth' });
    setTimeout(updateArrows, 180);
  };

  nextBtn.onclick = () => {
    tabsBar.scrollBy({ left: 140, behavior: 'smooth' });
    setTimeout(updateArrows, 180);
  };

  // Drag-to-scroll support for mouse/trackpad
  let isDown = false;
  let startX = 0;
  let scrollStart = 0;

  tabsBar.addEventListener('mousedown', (e) => {
    isDown = true;
    startX = e.pageX - tabsBar.offsetLeft;
    scrollStart = tabsBar.scrollLeft;
  });
  window.addEventListener('mouseup', () => { isDown = false; });
  tabsBar.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - tabsBar.offsetLeft;
    const walk = (x - startX) * 1.5;
    tabsBar.scrollLeft = scrollStart - walk;
    updateArrows();
  });

  // Mouse wheel horizontal scroll support
  tabsBar.addEventListener('wheel', (e) => {
    if (e.deltaY !== 0) {
      e.preventDefault();
      tabsBar.scrollLeft += e.deltaY;
      updateArrows();
    }
  }, { passive: false });

  tabsBar.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows, { passive: true });

  setTimeout(updateArrows, 60);
  setTimeout(updateArrows, 300);

  // Tab click delegation
  tabsBar.addEventListener('click', (e) => {
    const tab = e.target.closest('.filter-tab');
    if (!tab) return;

    tabsBar.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');

    // Smoothly scroll active tab into view
    tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

    state.filterCategory = tab.getAttribute('data-cat') || 'all';
    renderSources();
  });
}

// ══════════════════════════════════════════════════════════════
// EVENT BINDINGS
// ══════════════════════════════════════════════════════════════

function bindUIEvents() {
  const app = document.getElementById('app-root');
  document.getElementById('btn-toggle-left-sidebar').addEventListener('click', () => {
    app.classList.toggle('sidebar-collapsed');
  });
  document.getElementById('btn-toggle-right-panel').addEventListener('click', () => {
    app.classList.toggle('sidepanel-collapsed');
  });

  document.getElementById('btn-toggle-theme').addEventListener('click', toggleTheme);
  document.getElementById('btn-trigger-login-modal').addEventListener('click', openAuthModal);
  document.getElementById('btn-profile-popover-trigger').addEventListener('click', () => {
    document.getElementById('user-popover-menu').classList.toggle('active');
  });

  document.getElementById('btn-open-live-dialog').addEventListener('click', openLiveDialog);
  document.getElementById('btn-quick-add-source').addEventListener('click', openAddSourceModal);
  document.getElementById('btn-sidebar-add-source').addEventListener('click', openAddSourceModal);
  document.getElementById('btn-sync-live-news').addEventListener('click', () => loadGoogleDriveFiles(true));
  document.getElementById('btn-open-settings').addEventListener('click', openSettings);

  // Category carousel with < and > controls
  initCategoryCarousel();

  // Search input
  document.getElementById('global-search').addEventListener('input', (e) => {
    state.searchQuery = e.target.value.trim();
    renderSources();
  });

  // Copy document
  document.getElementById('btn-copy-reader-text').addEventListener('click', () => {
    const doc = state.sources.find(s => s.id === state.selectedDocId);
    if (doc?.content) {
      navigator.clipboard.writeText(doc.content);
      showToast('Document text copied');
    }
  });

  // Enter to send textarea
  document.getElementById('chat-textarea').addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      document.getElementById('chat-submit-form').dispatchEvent(new Event('submit'));
    }
  });
}

// ══════════════════════════════════════════════════════════════
// GOOGLE DRIVE CLOUD VAULT INTEGRATION
// ══════════════════════════════════════════════════════════════

let driveTokenClient = null;
let isSyncingNotes = false;

function initDriveOAuth() {
  if (typeof google === 'undefined' || !google.accounts || !google.accounts.oauth2) {
    return;
  }
  try {
    driveTokenClient = google.accounts.oauth2.initTokenClient({
      client_id: state.googleClientId,
      scope: 'https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.metadata.readonly',
      callback: async (tokenResponse) => {
        if (tokenResponse && tokenResponse.access_token) {
          state.driveToken = tokenResponse.access_token;
          const expiresIn = parseInt(tokenResponse.expires_in, 10) || 3600;
          state.driveTokenExpires = Date.now() + expiresIn * 1000;
          state.isDriveConnected = true;
          localStorage.setItem('nbl_drive_token', state.driveToken);
          localStorage.setItem('nbl_drive_token_expires', state.driveTokenExpires);

          showToast('Google Drive connected successfully');
          updateDriveUI();
          await fetchDriveQuota();
          await ensureDriveAppFolder();
          syncCurrentNotesToDrive(true);
          loadGoogleDriveFiles(true);
        } else if (tokenResponse && tokenResponse.error) {
          console.error('[Drive Auth Error]', tokenResponse);
          showToast(`Drive connection error: ${tokenResponse.error}`);
        }
      }
    });
  } catch (err) {
    console.warn('[Drive] initTokenClient failed:', err);
  }
}

function initDriveSession() {
  try {
    const savedToken = localStorage.getItem('nbl_drive_token');
    const expires = parseInt(localStorage.getItem('nbl_drive_token_expires') || '0', 10);
    const folderId = localStorage.getItem('nbl_drive_folder_id');
    const webAppUrl = localStorage.getItem('nbl_drive_webapp_url');

    if (folderId) state.driveFolderId = folderId;
    if (webAppUrl) {
      state.driveWebAppUrl = webAppUrl;
      const input = document.getElementById('input-drive-webapp-url');
      if (input) input.value = webAppUrl;
    }

    if (savedToken && expires > Date.now()) {
      state.driveToken = savedToken;
      state.driveTokenExpires = expires;
      state.isDriveConnected = true;
      updateDriveUI();
      fetchDriveQuota();
      loadGoogleDriveFiles();
    } else {
      state.isDriveConnected = false;
      state.driveToken = null;
      updateDriveUI();
      renderSources();
    }
  } catch (e) {
    console.warn('[Drive] Session load error:', e);
  }
}

async function fetchServerDriveConfig() {
  try {
    const res = await fetch('/api/drive/config');
    if (res.ok) {
      const data = await res.json();
      if (data.clientId) state.googleClientId = data.clientId;
      if (data.webAppUrl && !state.driveWebAppUrl) {
        state.driveWebAppUrl = data.webAppUrl;
        const input = document.getElementById('input-drive-webapp-url');
        if (input) input.value = data.webAppUrl;
      }
    }
  } catch (e) {}
}

function handleDriveMainAction() {
  if (state.isDriveConnected) {
    syncCurrentNotesToDrive(false);
  } else {
    connectGoogleDrive();
  }
}

function connectGoogleDrive() {
  if (!driveTokenClient) {
    initDriveOAuth();
  }
  if (driveTokenClient) {
    const promptConfig = state.user?.email ? { prompt: 'consent', hint: state.user.email } : { prompt: 'consent' };
    driveTokenClient.requestAccessToken(promptConfig);
  } else {
    showToast('Google Drive authentication service loading. Please try again.');
  }
}

function disconnectGoogleDrive() {
  if (state.driveToken && typeof google !== 'undefined' && google.accounts?.oauth2?.revoke) {
    try {
      google.accounts.oauth2.revoke(state.driveToken, () => {});
    } catch(e) {}
  }
  state.driveToken = null;
  state.driveTokenExpires = 0;
  state.isDriveConnected = false;
  state.driveStorage = null;
  state.driveFiles = [];
  state.sources = [];
  state.activeSourceIds.clear();
  state.selectedDocId = null;
  localStorage.removeItem('nbl_drive_token');
  localStorage.removeItem('nbl_drive_token_expires');
  updateDriveUI();
  renderSources();
  showToast('Google Drive disconnected');
}

function updateDriveUI() {
  const connDot = document.getElementById('drive-conn-dot');
  const modalDot = document.getElementById('modal-drive-dot');
  const driveStatusLabel = document.getElementById('drive-status-label');
  const storageStatusText = document.getElementById('storage-status-text');
  const storageBarFill = document.getElementById('storage-bar-fill');
  const popoverDriveBadge = document.getElementById('popover-drive-badge');
  const popoverDriveQuota = document.getElementById('popover-drive-quota');
  const modalDriveBadge = document.getElementById('modal-drive-badge');
  const modalDriveStatusText = document.getElementById('modal-drive-status-text');
  const modalDriveAccountText = document.getElementById('modal-drive-account-text');
  const modalQuotaText = document.getElementById('modal-quota-text');
  const modalQuotaBar = document.getElementById('modal-quota-bar');
  const btnDriveMain = document.getElementById('btn-drive-main-action');
  const syncNotesBtn = document.getElementById('btn-sync-notes-drive');

  if (state.isDriveConnected && state.driveStorage) {
    const usageNum = parseInt(state.driveStorage.usage || '0', 10);
    const limitNum = state.driveStorage.limit ? parseInt(state.driveStorage.limit, 10) : 0;
    const usageStr = formatBytes(usageNum);
    const limitStr = limitNum > 0 ? formatBytes(limitNum) : 'Unlimited';
    const pct = limitNum > 0 ? Math.min(100, Math.max(0.5, (usageNum / limitNum) * 100)) : 12;

    if (connDot) connDot.classList.add('connected');
    if (modalDot) modalDot.classList.add('connected');
    if (driveStatusLabel) driveStatusLabel.textContent = 'Drive Vault';
    if (storageStatusText) storageStatusText.textContent = `${usageStr} / ${limitStr}`;
    if (storageBarFill) storageBarFill.style.width = `${pct.toFixed(1)}%`;

    if (popoverDriveBadge) {
      popoverDriveBadge.textContent = 'Connected';
      popoverDriveBadge.classList.add('connected');
    }
    if (popoverDriveQuota) popoverDriveQuota.textContent = `${usageStr} / ${limitStr} used`;

    if (modalDriveBadge) {
      modalDriveBadge.textContent = 'Connected';
      modalDriveBadge.classList.add('connected');
    }
    if (modalDriveStatusText) modalDriveStatusText.textContent = 'Connected to Google Drive';
    if (modalDriveAccountText) modalDriveAccountText.textContent = state.user?.email ? `Authorized as ${state.user.email}` : 'Active OAuth session';
    if (modalQuotaText) modalQuotaText.textContent = `${usageStr} of ${limitStr} (${pct.toFixed(1)}%)`;
    if (modalQuotaBar) modalQuotaBar.style.width = `${pct.toFixed(1)}%`;
    if (btnDriveMain) {
      btnDriveMain.textContent = 'Sync Lab Notes Now';
      btnDriveMain.style.background = 'var(--text-main)';
    }
    if (syncNotesBtn) syncNotesBtn.style.opacity = '1';
  } else if (state.isDriveConnected) {
    if (connDot) connDot.classList.add('connected');
    if (modalDot) modalDot.classList.add('connected');
    if (driveStatusLabel) driveStatusLabel.textContent = 'Drive Vault';
    if (storageStatusText) storageStatusText.textContent = 'Drive Active';
    if (storageBarFill) storageBarFill.style.width = '2%';
    if (modalDriveBadge) {
      modalDriveBadge.textContent = 'Connected';
      modalDriveBadge.classList.add('connected');
    }
    if (modalDriveStatusText) modalDriveStatusText.textContent = 'Connected to Google Drive';
    if (modalDriveAccountText) modalDriveAccountText.textContent = 'Checking quota...';
    if (btnDriveMain) btnDriveMain.textContent = 'Sync Lab Notes Now';
  } else {
    if (connDot) connDot.classList.remove('connected');
    if (modalDot) modalDot.classList.remove('connected');
    if (driveStatusLabel) driveStatusLabel.textContent = 'Local Vault';
    if (storageStatusText) storageStatusText.textContent = 'Connect Drive';
    if (storageBarFill) storageBarFill.style.width = '0.2%';

    if (popoverDriveBadge) {
      popoverDriveBadge.textContent = 'Local';
      popoverDriveBadge.classList.remove('connected');
    }
    if (popoverDriveQuota) popoverDriveQuota.textContent = 'Click to connect cloud vault';

    if (modalDriveBadge) {
      modalDriveBadge.textContent = 'Local Vault';
      modalDriveBadge.classList.remove('connected');
    }
    if (modalDriveStatusText) modalDriveStatusText.textContent = 'Disconnected';
    if (modalDriveAccountText) modalDriveAccountText.textContent = 'Notes stay saved locally until connected';
    if (modalQuotaText) modalQuotaText.textContent = 'Not connected';
    if (modalQuotaBar) modalQuotaBar.style.width = '0%';
    if (btnDriveMain) {
      btnDriveMain.textContent = 'Connect Google Drive';
      btnDriveMain.style.background = 'var(--accent)';
    }
  }
}

async function fetchDriveQuota() {
  if (!state.driveToken || !state.isDriveConnected) return null;
  try {
    const res = await fetch('https://www.googleapis.com/drive/v3/about?fields=storageQuota,user', {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });

    if (res.status === 401) {
      console.warn('[Drive] Token expired');
      disconnectGoogleDrive();
      return null;
    }

    if (res.ok) {
      const data = await res.json();
      state.driveStorage = data.storageQuota;
      if (data.user && !state.user) {
        state.user = {
          name: data.user.displayName || 'Google User',
          email: data.user.emailAddress || '',
          picture: data.user.photoLink || ''
        };
        localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
        renderAuthUI();
      }
      updateDriveUI();
      return data.storageQuota;
    }
  } catch (err) {
    console.warn('[Drive Quota Error]', err);
  }
  return null;
}

async function ensureDriveAppFolder() {
  if (!state.driveToken) return null;
  if (state.driveFolderId) {
    try {
      const checkRes = await fetch(`https://www.googleapis.com/drive/v3/files/${state.driveFolderId}?fields=id,name,trashed`, {
        headers: { Authorization: `Bearer ${state.driveToken}` }
      });
      if (checkRes.ok) {
        const folder = await checkRes.json();
        if (!folder.trashed) return state.driveFolderId;
      }
    } catch (e) {}
  }

  try {
    const q = encodeURIComponent("name = 'Research Lab (NBLMimic)' and mimeType = 'application/vnd.google-apps.folder' and trashed = false");
    const searchRes = await fetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name)`, {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });
    if (searchRes.ok) {
      const data = await searchRes.json();
      if (data.files && data.files.length > 0) {
        state.driveFolderId = data.files[0].id;
        localStorage.setItem('nbl_drive_folder_id', state.driveFolderId);
        return state.driveFolderId;
      }
    }

    const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${state.driveToken}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        name: 'Research Lab (NBLMimic)',
        mimeType: 'application/vnd.google-apps.folder'
      })
    });
    if (createRes.ok) {
      const newFolder = await createRes.json();
      state.driveFolderId = newFolder.id;
      localStorage.setItem('nbl_drive_folder_id', newFolder.id);
      return newFolder.id;
    }
  } catch (err) {
    console.error('[Drive Folder Error]', err);
  }
  return null;
}

async function syncCurrentNotesToDrive(silent = false) {
  if (!state.isDriveConnected || !state.driveToken) {
    if (!silent) {
      openDriveModal();
      showToast('Connect Google Drive to sync notes');
    }
    return;
  }

  if (isSyncingNotes) return;
  isSyncingNotes = true;

  const syncLabel = document.getElementById('label-sync-notes');
  const notesStatusLabel = document.getElementById('notes-status-label');
  if (syncLabel) syncLabel.textContent = 'Syncing...';
  if (notesStatusLabel) notesStatusLabel.textContent = 'Syncing to Google Drive...';

  try {
    const folderId = await ensureDriveAppFolder();
    const content = state.notesContent || '# Research Lab Notes\n\nNo notes recorded yet.';
    const fileName = 'Research_Notes.md';

    let existingFileId = null;
    if (folderId) {
      const query = encodeURIComponent(`name = '${fileName}' and '${folderId}' in parents and trashed = false`);
      const searchRes = await fetch(`https://www.googleapis.com/drive/v3/files?q=${query}&fields=files(id,name)`, {
        headers: { Authorization: `Bearer ${state.driveToken}` }
      });
      if (searchRes.ok) {
        const searchData = await searchRes.json();
        if (searchData.files && searchData.files.length > 0) {
          existingFileId = searchData.files[0].id;
        }
      }
    }

    let uploadRes;
    if (existingFileId) {
      uploadRes = await fetch(`https://www.googleapis.com/upload/drive/v3/files/${existingFileId}?uploadType=media`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${state.driveToken}`,
          'Content-Type': 'text/markdown; charset=utf-8'
        },
        body: content
      });
    } else {
      const metadata = {
        name: fileName,
        mimeType: 'text/markdown',
        parents: folderId ? [folderId] : []
      };

      const boundary = '-------314159265358979323846';
      const delimiter = "\r\n--" + boundary + "\r\n";
      const closeDelim = "\r\n--" + boundary + "--";

      const multipartRequestBody =
        delimiter +
        'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
        JSON.stringify(metadata) +
        delimiter +
        'Content-Type: text/markdown; charset=UTF-8\r\n\r\n' +
        content +
        closeDelim;

      uploadRes = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${state.driveToken}`,
          'Content-Type': `multipart/related; boundary=${boundary}`
        },
        body: multipartRequestBody
      });
    }

    if (state.driveWebAppUrl) {
      try {
        fetch(state.driveWebAppUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: state.user?.name || 'researcher',
            action: 'saveNote',
            title: 'Research_Notes',
            content: content
          })
        }).catch(() => {});
      } catch (e) {}
    }

    if (uploadRes && uploadRes.ok) {
      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (notesStatusLabel) notesStatusLabel.textContent = `Synced to Google Drive (${timeStr})`;
      if (syncLabel) syncLabel.textContent = 'Synced ✓';
      setTimeout(() => { if (syncLabel) syncLabel.textContent = 'Sync Drive'; }, 2500);
      if (!silent) showToast('Notes successfully backed up to Google Drive');
      fetchDriveQuota();
    } else {
      throw new Error(`Upload failed with status ${uploadRes?.status}`);
    }
  } catch (err) {
    console.error('[Drive Sync Error]', err);
    if (notesStatusLabel) notesStatusLabel.textContent = 'Saved to local vault (Drive sync offline)';
    if (syncLabel) syncLabel.textContent = 'Sync Failed';
    setTimeout(() => { if (syncLabel) syncLabel.textContent = 'Sync Drive'; }, 3000);
    if (!silent) showToast('Failed to sync to Google Drive. Check permissions.');
  } finally {
    isSyncingNotes = false;
  }
}

async function fetchUserDriveFiles(queryFilter = '') {
  if (!state.driveToken || !state.isDriveConnected) {
    const listEl = document.getElementById('drive-files-list-container');
    if (listEl) {
      listEl.innerHTML = '<div style="padding:24px 16px; text-align:center; color:var(--text-tertiary); font-size:12px;">Connect Google Drive above to list and import files.</div>';
    }
    return [];
  }

  const listEl = document.getElementById('drive-files-list-container');
  if (listEl) listEl.innerHTML = '<div style="padding:20px; text-align:center; color:var(--text-tertiary); font-size:12px;">Loading your Google Drive documents...</div>';

  try {
    let q = "trashed = false and (mimeType = 'text/plain' or mimeType = 'text/markdown' or mimeType = 'application/json' or mimeType = 'application/pdf' or mimeType = 'application/vnd.google-apps.document')";
    if (queryFilter) {
      const cleanF = queryFilter.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      q += ` and name contains '${cleanF}'`;
    }

    const url = `https://www.googleapis.com/drive/v3/files?q=${encodeURIComponent(q)}&pageSize=30&orderBy=modifiedTime desc&fields=files(id,name,mimeType,size,modifiedTime)`;
    const res = await fetch(url, {
      headers: { Authorization: `Bearer ${state.driveToken}` }
    });

    if (res.ok) {
      const data = await res.json();
      state.driveFiles = data.files || [];
      renderDriveFilesList();
      return state.driveFiles;
    } else {
      if (listEl) listEl.innerHTML = '<div style="padding:20px; text-align:center; color:var(--danger); font-size:12px;">Could not fetch Drive files. Token may need renewal.</div>';
    }
  } catch (err) {
    if (listEl) listEl.innerHTML = `<div style="padding:20px; text-align:center; color:var(--danger); font-size:12px;">Error loading files: ${err.message}</div>`;
  }
  return [];
}

function renderDriveFilesList() {
  const container = document.getElementById('drive-files-list-container');
  if (!container) return;

  if (!state.driveFiles || state.driveFiles.length === 0) {
    container.innerHTML = '<div style="padding:24px 16px; text-align:center; color:var(--text-tertiary); font-size:12px;">No documents or text files found in your Drive.</div>';
    return;
  }

  container.innerHTML = state.driveFiles.map(file => {
    const isDoc = file.mimeType === 'application/vnd.google-apps.document';
    const isPdf = file.mimeType === 'application/pdf';
    const iconSvg = isDoc
      ? '<span style="color:#2563eb; font-weight:700;">DOC</span>'
      : (isPdf ? '<span style="color:#ef4444; font-weight:700;">PDF</span>' : '<span style="color:#10b981; font-weight:700;">TXT</span>');

    const sizeStr = file.size ? formatBytes(file.size) : (isDoc ? 'Doc' : 'Text');
    const modDate = file.modifiedTime ? new Date(file.modifiedTime).toLocaleDateString([], { month: 'short', day: 'numeric' }) : '';

    return `
      <div class="drive-file-row" onclick="importDriveFileToNotebook('${file.id}', '${escapeHtml(file.name)}', '${file.mimeType}')" title="Click to import into research sources">
        <div class="drive-file-item-name">
          <span style="font-size:10px; font-family:var(--font-mono);">${iconSvg}</span>
          <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:260px;">${escapeHtml(file.name)}</span>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
          <span class="drive-file-meta">${sizeStr} &middot; ${modDate}</span>
          <button class="btn-tiny-action" style="height:22px; font-size:11px; padding:0 6px;">Import</button>
        </div>
      </div>
    `;
  }).join('');
}

async function importDriveFileToNotebook(fileId, fileName, mimeType) {
  showToast(`Importing ${fileName}...`);
  try {
    let content = '';
    if (mimeType === 'application/vnd.google-apps.document') {
      const expRes = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}/export?mimeType=text/plain`, {
        headers: { Authorization: `Bearer ${state.driveToken}` }
      });
      if (!expRes.ok) throw new Error('Could not export Google Doc');
      content = await expRes.text();
    } else if (mimeType === 'application/pdf') {
      content = `# ${fileName}\n\n[Google Drive PDF Document]\nImported directly from user Google Drive vault.\nRefer to Google Drive to review native PDF graphics or export text.`;
    } else {
      const rawRes = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, {
        headers: { Authorization: `Bearer ${state.driveToken}` }
      });
      if (!rawRes.ok) throw new Error('Could not download file media');
      content = await rawRes.text();
    }

    const newDoc = {
      id: Date.now(),
      type: 'drive',
      title: fileName,
      source: 'Google Drive',
      category: 'Notes & Uploads',
      excerpt: content.slice(0, 140) + '…',
      content: content,
      date: 'Just now',
      timestamp: Date.now(),
      driveFileId: fileId
    };

    state.sources.unshift(newDoc);
    state.activeSourceIds.add(newDoc.id);
    renderSources();
    viewDocument(newDoc.id);
    closeDriveModal();
    closeAddSourceModal();
    showToast(`✓ "${fileName}" imported into research sources`);
  } catch (err) {
    console.error('[Drive Import Error]', err);
    showToast(`Failed to import file: ${err.message}`);
  }
}

function saveDriveWebAppUrl() {
  const input = document.getElementById('input-drive-webapp-url');
  if (input) {
    const url = input.value.trim();
    state.driveWebAppUrl = url;
    localStorage.setItem('nbl_drive_webapp_url', url);
    showToast('Apps Script Butler URL saved');
  }
}

function formatBytes(bytes, decimals = 1) {
  if (!bytes || bytes === 0) return '0 B';
  const num = typeof bytes === 'string' ? parseInt(bytes, 10) : bytes;
  if (isNaN(num) || num <= 0) return '0 B';
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(num) / Math.log(k));
  return parseFloat((num / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function showToast(msg) {
  const tray = document.getElementById('toast-tray');
  const pill = document.createElement('div');
  pill.className = 'toast-pill';
  pill.textContent = msg;
  tray.appendChild(pill);
  setTimeout(() => {
    pill.style.opacity = '0';
    pill.style.transform = 'translateY(6px)';
    pill.style.transition = 'all 140ms ease';
    setTimeout(() => pill.remove(), 160);
  }, 2800);
}
</script>

</body>
</html>
