  notesContent: '',
  isSignUpMode: false,
  googleClientId: '809750403592-tven0oabpuiq37oi8um5f102ck3lclkg.apps.googleusercontent.com',
  // Google Drive Cloud State
  driveToken: null,
  driveTokenExpires: 0,
  isDriveConnected: false,
  driveFolderId: null,
  driveStorage: null,
  driveFiles: [],
  driveWebAppUrl: ''
};

