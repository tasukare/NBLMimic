// ══════════════════════════════════════════════════════════════
// AUTHENTICATION & GOOGLE OAUTH
// ══════════════════════════════════════════════════════════════

async function fetchServerAuth() {
  try {
    const res = await fetch('/api/auth/config');
    if (res.ok) {
      const data = await res.json();
      if (data.clientId) {
        state.googleClientId = data.clientId;
        initGoogleGSI();
      }
    }
  } catch (e) {}
}

function initGoogleGSI() {
  if (typeof google === 'undefined' || !google.accounts || !google.accounts.id) return;
  try {
    google.accounts.id.initialize({
      client_id: state.googleClientId,
      callback: onGoogleCredentialResponse,
      auto_select: false,
      cancel_on_tap_outside: true
    });

    const mount = document.getElementById('gsi-official-mount');
    if (mount) {
      google.accounts.id.renderButton(mount, {
        type: 'standard',
        shape: 'rectangular',
        theme: 'outline',
        size: 'large',
        width: 340
      });
    }

    initDriveOAuth();
  } catch (err) {
    console.warn('[GSI] Init issue:', err);
  }
}

function triggerGoogleOAuth() {
  if (typeof google !== 'undefined' && google.accounts?.id) {
    google.accounts.id.prompt((notification) => {
      if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
        const mount = document.getElementById('gsi-official-mount');
        if (mount) {
          mount.style.display = 'block';
          const btn = mount.querySelector('div[role="button"]');
          if (btn) btn.click();
        }
      }
    });
  } else {
    showToast('Google OAuth service loading...');
  }
}

function onGoogleCredentialResponse(response) {
  if (!response?.credential) return;
  try {
    const base64Url = response.credential.split('.')[1];
    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
    const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => {
      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
    }).join(''));

    const profile = JSON.parse(jsonPayload);
    state.user = {
      name: profile.name || 'Google User',
      email: profile.email || '',
      picture: profile.picture || '',
      sub: profile.sub
    };

    localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
    renderAuthUI();
    closeAuthModal();
    showToast(`Signed in as ${state.user.name}`);
  } catch (err) {
    showToast('Could not process Google sign-in token');
  }
}

function initUserSession() {
  try {
    const saved = localStorage.getItem('nbl_user_session');
    if (saved) state.user = JSON.parse(saved);
  } catch (e) {}
  renderAuthUI();
}

function renderAuthUI() {
  const btnTrigger = document.getElementById('btn-trigger-login-modal');
  const userMenuWrap = document.getElementById('user-signedin-menu-wrap');
  const signedInSection = document.getElementById('auth-signedin-section');
  const signedOutSection = document.getElementById('auth-signedout-section');

  if (state.user) {
    btnTrigger.style.display = 'none';
    userMenuWrap.style.display = 'flex';

    const initial = (state.user.name || state.user.email || 'U')[0].toUpperCase();
    document.getElementById('nav-user-initial').textContent = initial;
    document.getElementById('popover-avatar-initial').textContent = initial;
    document.getElementById('modal-signed-initial').textContent = initial;

    const navImg = document.getElementById('nav-user-img');
    const popImg = document.getElementById('popover-avatar-img');
    const modalImg = document.getElementById('modal-signed-img');

    if (state.user.picture) {
      navImg.src = state.user.picture;
      navImg.style.display = 'block';
      document.getElementById('nav-user-initial').style.display = 'none';

      popImg.src = state.user.picture;
      popImg.style.display = 'block';
      document.getElementById('popover-avatar-initial').style.display = 'none';

      modalImg.src = state.user.picture;
      modalImg.style.display = 'block';
      document.getElementById('modal-signed-initial').style.display = 'none';
    } else {
      navImg.style.display = 'none';
      document.getElementById('nav-user-initial').style.display = 'block';
      popImg.style.display = 'none';
      document.getElementById('popover-avatar-initial').style.display = 'block';
      modalImg.style.display = 'none';
      document.getElementById('modal-signed-initial').style.display = 'block';
    }

    document.getElementById('popover-user-name').textContent = state.user.name;
    document.getElementById('popover-user-email').textContent = state.user.email;
    document.getElementById('modal-signed-name').textContent = state.user.name;
    document.getElementById('modal-signed-email').textContent = state.user.email;

    signedInSection.style.display = 'block';
    signedOutSection.style.display = 'none';
    document.getElementById('auth-modal-title').textContent = 'Account Profile';
    document.getElementById('auth-modal-sub').textContent = 'Connected with Google Account and local vault.';
  } else {
    btnTrigger.style.display = 'inline-flex';
    userMenuWrap.style.display = 'none';
    document.getElementById('user-popover-menu').classList.remove('active');

    signedInSection.style.display = 'none';
    signedOutSection.style.display = 'block';
    document.getElementById('auth-modal-title').textContent = state.isSignUpMode ? 'Create an Account' : 'Sign in to Research Lab';
    document.getElementById('auth-modal-sub').textContent = 'Continue with your Google account or email to sync your private notebook.';
  }
}

function signOutUser() {
  state.user = null;
  localStorage.removeItem('nbl_user_session');
  renderAuthUI();
  closeAuthModal();
  document.getElementById('user-popover-menu').classList.remove('active');
  showToast('Signed out of session');
}

function handleDirectAuthSubmit(e) {
  e.preventDefault();
  const email = document.getElementById('auth-input-email').value.trim();
  if (!email) return;

  const displayName = email.includes('@') ? email.split('@')[0] : email;
  state.user = {
    name: displayName,
    email: email.includes('@') ? email : `${email}@gmail.com`,
    picture: ''
  };

  localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
  renderAuthUI();
  closeAuthModal();
  showToast(`Welcome, ${displayName}`);
}

function loginDemoAccount() {
  state.user = {
    name: 'Dr. Jane Vance',
    email: 'jane.vance.research@gmail.com',
    picture: ''
  };
  localStorage.setItem('nbl_user_session', JSON.stringify(state.user));
  renderAuthUI();
  closeAuthModal();
  showToast('Logged in with Demo Researcher session');
}

function toggleAuthMode() {
  state.isSignUpMode = !state.isSignUpMode;
  const btnMode = document.getElementById('btn-auth-mode-toggle');
  const btnSubmit = document.getElementById('btn-submit-auth');
  const label = document.getElementById('auth-switch-label');

  if (state.isSignUpMode) {
    document.getElementById('auth-modal-title').textContent = 'Create an Account';
    btnSubmit.textContent = 'Create Account';
    label.textContent = 'Already have an account?';
    btnMode.textContent = 'Sign in';
  } else {
    document.getElementById('auth-modal-title').textContent = 'Sign in to Research Lab';
    btnSubmit.textContent = 'Sign in with Email';
    label.textContent = "Don't have an account?";
    btnMode.textContent = 'Sign up';
  }
}

